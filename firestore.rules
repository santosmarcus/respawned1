rules_version = '2';

// ---------------------------------------------------------------------------
// NEWLY AUTHORED — no firestore.rules file existed in this repository before
// this change, even though firebase.json already points "firestore.rules" at
// this exact path. Numerous code comments across lib/core/repos/*.dart
// describe "this app's existing wide-open Firestore rules" as the current
// live behavior for most collections — meaning whatever rules are actually
// deployed today are NOT visible from this checkout, and this file has never
// been deployed or tested against the live project or the Firestore emulator.
//
// Scope of what's actually enforced here (Organization Invitations spec §16,
// extended by the Temporary Organization Admin/Member Access Model spec):
//   - organizationInvitations/{invitationId} — create/read/update now also
//     allow an active org member (any role) or the org's ownerId, not just
//     an admin membership doc, matching the app-side temporary equal-access
//     phase for Owner/Admin/Member. No change to organizationInvitations
//     delete (still always false) or to organizations/{orgId}/members
//     create/update/delete (still admin/owner-only — removing or promoting
//     real staff stays a stricter operation than inviting/managing pending
//     invitations).
//   - organizations/{orgId}/members/{uid}
// Every other collection keeps the same effectively-open
// "any signed-in user" access the rest of this codebase already assumes,
// specifically so deploying this file cannot newly break any of the
// dozens of other collections (cases, adoptions, animalRecords, donations,
// auditLogs, collarTags, settings, etc.) this rules file was not written
// against a full audit of. Tightening those is a separate, larger security
// review outside this feature's scope — do not treat this file as a
// comprehensive lockdown.
//
// BEFORE DEPLOYING (`firebase deploy --only firestore:rules`): review this
// file against the Firestore Rules Playground or emulator with real data,
// since an incorrect rule here can silently break legitimate reads/writes
// app-wide. This was authored from static code inspection only.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    // organizations/{orgId} document itself (profile/verification fields) —
    // unchanged from the app's existing effectively-open behavior. Does NOT
    // cascade to the members subcollection below — Firestore rules never
    // apply to subcollections unless explicitly matched.
    match /organizations/{orgId} {
      allow read, write: if signedIn();
    }

    // organizations/{orgId}/members/{uid} — spec §16:
    //   - Users cannot create arbitrary memberships for themselves.
    //   - Membership creation through acceptance must verify the invitation.
    //   - Ordinary members cannot change their own role to admin.
    //   - Organization admins cannot remove the last active admin.
    // Reads stay open to any signed-in user (Staff Members / duplicate-org
    // checks already read across organizations client-side, matching the
    // rest of this app's current privacy posture) — only writes are gated.
    match /organizations/{orgId}/members/{uid} {
      allow read: if signedIn();

      function isOrgAdmin() {
        return signedIn() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }

      function isOwner() {
        return signedIn() &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
      }

      // A brand-new membership doc may only be created by:
      //  (a) an org admin directly adding someone (invite-less legacy path /
      //      admin tooling), or
      //  (b) the invited person themselves, but ONLY when a matching
      //      pending invitation for their own email actually exists for
      //      this organization+uid — this is the "verify the invitation"
      //      requirement; a user can never simply write themselves in.
      function acceptingOwnValidInvitation() {
        let invitationId = request.resource.data.invitationId;
        return invitationId is string && invitationId.size() > 0 &&
          exists(/databases/$(database)/documents/organizationInvitations/$(invitationId)) &&
          get(/databases/$(database)/documents/organizationInvitations/$(invitationId)).data.organizationId == orgId &&
          get(/databases/$(database)/documents/organizationInvitations/$(invitationId)).data.normalizedEmail == normalizedEmail() &&
          get(/databases/$(database)/documents/organizationInvitations/$(invitationId)).data.status == 'pending' &&
          request.auth.uid == uid;
      }

      allow create: if isOrgAdmin() || isOwner() || acceptingOwnValidInvitation();

      // Updates (role changes / status changes): only an org admin, EXCEPT
      // an ordinary member may never grant themselves admin — closes the
      // specific "members cannot change their own role to admin" gap even
      // for an admin-looking write that isn't actually coming from a real
      // admin account.
      allow update: if isOrgAdmin() &&
        !(request.auth.uid == uid && resource.data.role != 'admin' && request.resource.data.role == 'admin' && !isOrgAdmin());

      // Deletes (removal): only an org admin, and never the last one.
      // Counting admins requires a query, which rules can't run directly —
      // the client-side isFinalAdmin() pre-check
      // (OrganizationInvitationRepository) is the primary guard; this rule
      // additionally blocks an admin from deleting their OWN membership
      // when they are the organization's `ownerId`, since the owner must
      // always remain a member per spec §3.
      allow delete: if isOrgAdmin() && !(uid == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId);
    }

    // organizations/{orgId}/integrations/facebook — Facebook Page Sharing
    // spec. SAFE connection metadata only (pageId/pageName/pagePictureUrl/
    // connectionStatus/etc) — the raw Page access token is never written
    // here (it lives only in Google Secret Manager, touched exclusively by
    // the facebookConnectPage/facebookConfirmPageSelection/
    // facebookTestConnection/facebookDisconnectPage/
    // facebookPublishAnimalRecords Cloud Functions via the Admin SDK,
    // which bypasses these rules entirely). Reads: any active org member,
    // admin, or the owner may see connection status (spec: "Active Members
    // may also read basic safe connection status when the existing UI
    // needs it"). Writes: always false from the client — connecting,
    // reconnecting, disconnecting, and publishing are exclusively
    // Cloud-Function operations; nothing here needs a client write path.
    match /organizations/{orgId}/integrations/{docId} {
      function isOrgAdminOfIntegration() {
        return signedIn() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }
      function isActiveOrgMemberOfIntegration() {
        return signedIn() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          !(get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status in
            ['inactive', 'removed', 'disabled']);
      }
      function isOwnerOfIntegration() {
        return signedIn() &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
      }
      allow read: if isOrgAdminOfIntegration() || isActiveOrgMemberOfIntegration() || isOwnerOfIntegration();
      allow write: if false;
    }

    // facebookConnectRequests/{requestId} — Facebook Page Sharing spec.
    // Backend-only bookkeeping for the multi-Page-selection step of
    // connecting a Page (uid/organizationId/status/expiry + non-sensitive
    // page id/name/picture for display — never a token). The Flutter
    // client only ever learns its contents via the facebookConnectPage
    // callable's OWN return value, never by reading this collection
    // directly, so there is no legitimate client access path to close a
    // gap for — denied outright rather than scoped to "the requesting
    // uid" since no code anywhere reads it from the client SDK.
    match /facebookConnectRequests/{requestId} {
      allow read, write: if false;
    }

    // facebookShares/{shareId} — Facebook Page Sharing spec. Publish
    // history written only by facebookPublishAnimalRecords via the Admin
    // SDK. No client read path is used by any code in this change (no
    // share-history UI exists yet) — denied outright rather than opened
    // for a feature that doesn't read it, per "add a rule only for the
    // exact path a reproducible client operation needs."
    match /facebookShares/{shareId} {
      allow read, write: if false;
    }

    // organizationInvitations/{invitationId} — spec §16:
    //   - A user may read invitations addressed to their authenticated email.
    //   - A user may accept or reject only their own invitation.
    //   - Only authorized organization admins may create or cancel
    //     organization invitations.
    match /organizationInvitations/{invitationId} {
      function isOrgAdminOf(orgId) {
        return signedIn() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }

      // Temporary Organization Admin/Member Access Model spec — Staff
      // Members and invitations is an equal-access module during this
      // phase, so an active member (any status other than an explicit
      // 'inactive'/'removed'/'disabled') may also create/manage
      // invitations for their own organization, not just an admin. A
      // missing `status` field (every pre-existing membership doc) counts
      // as active, matching this app's existing fail-open behavior for
      // accounts that predate the `status` field entirely.
      function isActiveOrgMemberOf(orgId) {
        return signedIn() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          !(get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status in
            ['inactive', 'removed', 'disabled']);
      }

      // Facebook Page Publishing Compatibility / Temporary Access Model
      // spec — a legacy organization owner may have no membership subdoc
      // at all yet (see organizations/{orgId}/members block above); never
      // block them from managing their own organization's invitations just
      // because isOrgAdminOf/isActiveOrgMemberOf both require an existing
      // member doc.
      function isOwnerOf(orgId) {
        return signedIn() &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
      }

      // An org admin/member/owner managing their own organization's
      // invitations, OR the invited person reading/acting on an invitation
      // addressed to their own authenticated email — never a third party's.
      allow read: if signedIn() &&
        (resource.data.normalizedEmail == normalizedEmail() ||
          isOrgAdminOf(resource.data.organizationId) ||
          isActiveOrgMemberOf(resource.data.organizationId) ||
          isOwnerOf(resource.data.organizationId));

      allow create: if isOrgAdminOf(request.resource.data.organizationId) ||
        isActiveOrgMemberOf(request.resource.data.organizationId) ||
        isOwnerOf(request.resource.data.organizationId);

      // Admin/member staff actions (resend/change role/cancel) vs. the
      // invited person's own accept/reject are distinguished by which
      // fields change: the invited person may only ever flip status
      // pending -> accepted or pending -> rejected on their OWN
      // invitation, never touch an invitation addressed to someone else,
      // and never resurrect/alter a non-pending one. An org admin or
      // active member may update anything on their own organization's
      // invitations (resend/cancel/change intended role).
      allow update: if isOrgAdminOf(resource.data.organizationId) ||
        isActiveOrgMemberOf(resource.data.organizationId) ||
        isOwnerOf(resource.data.organizationId) ||
        (
          resource.data.normalizedEmail == normalizedEmail() &&
          resource.data.status == 'pending' &&
          (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected') &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role
        );

      allow delete: if false; // history is kept, not deleted (spec §9)
    }

    // Everything else: unchanged from this app's existing documented
    // behavior — any signed-in user. Explicitly excludes the collections
    // above so their tighter rules are the ones that actually govern those
    // paths (a broader match here would otherwise OR together with the
    // specific rules and defeat them) — 'facebookConnectRequests' and
    // 'facebookShares' added by the Facebook Page Sharing spec, same
    // pattern as the pre-existing 'organizationInvitations' exclusion; no
    // other collection name changed.
    match /{collection}/{docId} {
      allow read, write: if signedIn() &&
        collection != 'organizationInvitations' &&
        collection != 'facebookConnectRequests' &&
        collection != 'facebookShares';
    }
    // 'integrations' added by the Facebook Page Sharing spec, same pattern
    // as the pre-existing 'members' exclusion; every other organization
    // subcollection (communityReports, activityLogs, etc.) keeps exactly
    // the same access it had before this change.
    match /organizations/{orgId}/{subcollection}/{docId} {
      allow read, write: if signedIn() && subcollection != 'members' && subcollection != 'integrations';
    }
  }
}
