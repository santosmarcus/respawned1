rules_version = '2';

// Merged from the rules deployed in the Firebase console (campaigns,
// donations, users, collar tags, rescue sessions) and the repo's previous
// firestore.rules (organizations, members, invitations, Facebook). Overlapping
// matches OR together, so each path below is matched by exactly one block
// that actually grants access — the catch-alls exclude every collection that
// has its own block.
//
// Security pass (P0): users/{uid} can no longer self-assign staff roles or
// an organization; organizations can't self-approve; cases, animals and
// adoptions are writable only by the people each flow needs (owning
// organization's staff, reporter, assigned transporter, adopter).
//
// Still open to any signed-in user: reads of users, cases, animals and
// adoptions (the public map, job board and the duplicate-application check
// in adoption_application_service.dart query them unfiltered), organization
// subcollections other than members/integrations, and every collection not
// named below (collarTags, rescueSessions, petAlerts, ...). collarTags/
// rescueSessions have specific rules further down, but the app still
// creates and edits tags directly, so the catch-all keeps them open.
//
// Staff roles: users/{uid}.role 'admin'/'ngo_staff' (platform staff, set in
// the console only) or membership of an approved organization. An
// organization with no verificationStatus (bootstrapped by platform staff,
// or created before verification existed) counts as approved.
//
// Cloud Functions use the Admin SDK and bypass these rules.
// Tests: rules-tests/ (npm test, runs against the Firestore emulator).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ----------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function changedAny(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return userDoc().get('role', '');
    }

    function myOrgId() {
      return userDoc().get('organizationId', '');
    }

    // Console-assigned staff accounts main.dart routes straight into the
    // admin shell. Clients can't set these roles (see users/{uid}).
    function isPlatformStaff() {
      return signedIn() && myRole() in ['admin', 'ngo_staff'];
    }

    // System admins (users/{uid}.role 'system_admin', set in the console
    // only): the sign-up approval and user directory console. They read
    // profiles (below) and organizations and members (open to signed-in
    // users); they are not platform staff, so cases, animals, medical
    // records, adoptions and finances stay closed to them.
    function isSystemAdmin() {
      return signedIn() && myRole() == 'system_admin';
    }

    // ---- Organization membership helpers -----------------------------------
    //
    // Mirrors functions/org_access.js: the org's ownerId always counts, a
    // members doc counts while its status isn't inactive/removed/disabled
    // (missing status = active, for docs that predate the field).

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function orgOwnerId(orgId) {
      return get(orgPath(orgId)).data.get('ownerId', '');
    }

    function isOrgOwner(orgId) {
      return signedIn() && orgOwnerId(orgId) == request.auth.uid;
    }

    function inactiveStatuses() {
      return ['inactive', 'removed', 'disabled'];
    }

    function isActiveMember(orgId) {
      return signedIn() &&
        exists(memberPath(orgId, request.auth.uid)) &&
        !(get(memberPath(orgId, request.auth.uid)).data.get('status', 'active') in inactiveStatuses());
    }

    // The owner, or an active Admin member: members, invitations, the org
    // profile and its settings.
    function isOrgAdmin(orgId) {
      return isOrgOwner(orgId) ||
        (isActiveMember(orgId) && get(memberPath(orgId, request.auth.uid)).data.get('role', '') == 'admin');
    }

    function isOrgApproved(orgId) {
      return get(orgPath(orgId)).data.get('verificationStatus', 'approved') == 'approved';
    }

    // ---- Organization permissions ------------------------------------------
    //
    // Admins (and the owner) can do everything; Staff what members/{uid}
    // .permissions allow, set by an Admin through the setMemberAccess
    // callable (clients can't write it, see members/{uid}). The lists below
    // are copied from functions/org_permissions.json
    // (functions/org_permissions_sync.test.js keeps them in step).
    //
    // Members docs from before permissions keep working (same fallback as
    // functions/org_access.js and the app): role 'carer' is Animal care, any
    // other Staff is Full staff (+ Facebook posting with the old
    // facebookPublisher flag), and an account linked through
    // users.organizationId with no members doc is Full staff.
    //
    // An account acts only for the organization users/{uid}.organizationId
    // points at. That check comes first so everyone else stops before any
    // organization or member read: Firestore denies a request once it has
    // evaluated 1,000 expressions (rules-tests expression-budget.test.js).

    function allPermKeys() {
      return ['rescue', 'animals', 'care', 'adoptions', 'campaigns', 'financeView', 'financeManage', 'volunteers', 'insights', 'facebookPublish'];
    }

    function fullStaffPerms() {
      return ['rescue', 'animals', 'care', 'adoptions', 'campaigns', 'financeView', 'volunteers', 'insights'];
    }

    // Everything that works in the admin shell; daily care (and Facebook
    // posting) alone is the care-tasks screen, which needs none of the
    // dashboard, people or budget data these guard.
    function opsKeys() {
      return ['rescue', 'animals', 'adoptions', 'campaigns', 'financeView', 'financeManage', 'volunteers', 'insights'];
    }

    function permsOf(m) {
      return m.get('permissions',
        m.get('role', '') == 'carer' ? ['care'] :
          (m.get('facebookPublisher', false) == true ? fullStaffPerms().concat(['facebookPublish']) : fullStaffPerms()));
    }

    function memberHasAny(orgId, keys) {
      let mp = memberPath(orgId, request.auth.uid);
      let org = get(orgPath(orgId)).data;
      return org.get('verificationStatus', 'approved') == 'approved' && (
        org.get('ownerId', '') == request.auth.uid ||
        (!exists(mp) && fullStaffPerms().hasAny(keys)) ||
        (exists(mp) &&
          !(get(mp).data.get('status', 'active') in inactiveStatuses()) &&
          (get(mp).data.get('role', '') == 'admin' || permsOf(get(mp).data).hasAny(keys)))
      );
    }

    // Active member of `orgId` (their own organization) with any of `keys`.
    function staffWith(orgId, keys) {
      return signedIn() && orgId is string && orgId != '' && myOrgId() == orgId && memberHasAny(orgId, keys);
    }

    // The same, for the caller's own organization.
    function myStaffWith(keys) {
      return signedIn() && myOrgId() != '' && memberHasAny(myOrgId(), keys);
    }

    // Any active member with at least one permission (Admins included).
    function isMemberOf(orgId) {
      return staffWith(orgId, allPermKeys());
    }

    // May act on a record owned by `orgId` ('' = not owned by anyone yet,
    // the shared review pool) with any of `keys`; platform staff always.
    function canRecordOf(orgId, keys) {
      return isPlatformStaff() ||
        (orgId != '' && staffWith(orgId, keys)) ||
        (orgId == '' && myStaffWith(keys));
    }

    // A staff write may only (re)assign a record to an organization the
    // writer belongs to, with the same permission.
    function orgStampOk(keys) {
      return !changedAny(['organizationId']) ||
        isPlatformStaff() ||
        staffWith(request.resource.data.get('organizationId', ''), keys);
    }

    // Money. financeManage includes viewing. Platform roles grant nothing:
    // only the organization's own people see or move its money.
    function canViewFinance(orgId) {
      return staffWith(orgId, ['financeView', 'financeManage']);
    }

    function canManageFinance(orgId) {
      return staffWith(orgId, ['financeManage']);
    }

    // For records saved without an organization (older campaigns and
    // transfers): finance viewers of the caller's own organization.
    function canViewFinanceOrUnowned(orgId) {
      return (orgId is string && orgId != '' && canViewFinance(orgId)) ||
        (!(orgId is string && orgId != '') && myStaffWith(['financeView', 'financeManage']));
    }

    // ---- Organizations -----------------------------------------------------

    // Anyone signed in can read profiles. Only the organization's own staff
    // Admins edit them, and ownerId is fixed: it must be the creator on create and
    // can never change afterwards, since the owner gets admin rights over the
    // members subcollection.
    //
    // Verification: a new organization starts as 'draft' and its staff may
    // only submit it ('pending'), or resubmit after a rejection or a request
    // for changes. Approving, rejecting and asking for changes go through the
    // reviewOrganization callable (functions/index.js) only, so no client —
    // platform staff included — may set the decision or reviewer fields. An
    // approved organization's staff get the admin shell, so this must never
    // be self-service. Only platform staff may create an organization with
    // no verificationStatus (the bootstrap path in
    // OrganizationRepository.createBootstrapOrganization).
    match /organizations/{orgId} {
      function reviewFields() {
        return ['verificationRejectionReason', 'verificationReviewedBy',
          'verificationReviewedByName', 'verificationReviewedAt'];
      }

      function verificationOk() {
        return !changedAny(reviewFields()) && (
          !changedAny(['verificationStatus', 'bootstrapped']) || (
            !changedAny(['bootstrapped']) &&
            request.resource.data.get('verificationStatus', '') == 'pending' &&
            resource.data.get('verificationStatus', '') in ['draft', 'rejected', 'requiresChanges']
          ));
      }

      function platformStaffUpdateOk() {
        return isPlatformStaff() && !changedAny(reviewFields().concat(['verificationStatus']));
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        (isPlatformStaff() || (
          request.resource.data.get('verificationStatus', '') == 'draft' &&
          !('bootstrapped' in request.resource.data)
        ));
      allow update: if request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '') &&
        (platformStaffUpdateOk() || (isOrgAdmin(orgId) && verificationOk()));
      allow delete: if false;
    }

    // organizations/{orgId}/settings/{docId}: the organization's own
    // settings (settings/shelter: safe capacity, isolation spots, monthly
    // care budget, daily food use, riders wanted free; shelter_settings.dart).
    // Its members read them (the dashboard; settings/care lists the rounds
    // care staff tick); only its Admins change them.
    match /organizations/{orgId}/settings/{docId} {
      allow read: if isPlatformStaff() ||
        (docId == 'care' && isMemberOf(orgId)) ||
        (docId != 'care' && staffWith(orgId, opsKeys()));
      allow write: if isOrgAdmin(orgId);
    }

    // Dashboard gap 2: each day's care-round ticks (careRounds/{yyyy-MM-dd},
    // field done.<area>__<task> = who and when). Staff with daily care or
    // animal records tick and untick; nobody deletes a day.
    match /organizations/{orgId}/careRounds/{day} {
      allow read: if isPlatformStaff() || staffWith(orgId, ['care', 'animals']);
      allow create, update: if staffWith(orgId, ['care', 'animals']) &&
        request.resource.data.get('organizationId', '') == orgId;
      allow delete: if false;
    }

    // Dashboard gap 7: who is handling a Priority actions item. Staff claim
    // for themselves (and may take over a claim); they release their own,
    // admins release anyone's. sendDashboardDigest deletes lapsed ones.
    match /organizations/{orgId}/alertClaims/{key} {
      allow read: if isPlatformStaff() || staffWith(orgId, opsKeys());
      allow create, update: if (isPlatformStaff() || staffWith(orgId, opsKeys())) &&
        request.resource.data.get('byUid', '') == request.auth.uid &&
        request.resource.data.get('organizationId', '') == orgId;
      allow delete: if (isPlatformStaff() || staffWith(orgId, opsKeys())) &&
        (resource.data.get('byUid', '') == request.auth.uid || isOrgAdmin(orgId));
    }

    // Analytics gap 6: monthly summaries, written only by
    // writeAnalyticsSummaries / rebuildAnalyticsSummaries (dashboard_ops.js).
    match /organizations/{orgId}/analyticsSummaries/{month} {
      allow read: if isPlatformStaff() || staffWith(orgId, ['insights']);
      allow write: if false;
    }

    // organizations/{orgId}/members/{uid}
    //   - Only the owner or an active admin adds, edits, or removes members.
    //   - An invited person may create only their own doc, with the role,
    //     preset and permissions their pending invitation names.
    //   - Nobody writes permissions, preset or facebookPublisher* from the
    //     client: the setMemberAccess callable (functions/org_members.js)
    //     changes a member's access, with the last-Admin check and an audit
    //     entry. Admins may still change `role` directly (older app builds)
    //     until that path is removed.
    //   - Only the owner may change the owner's own membership, and it can
    //     never be deleted.
    // Reads stay open to signed-in users (Staff Members list, duplicate-email
    // checks).
    match /organizations/{orgId}/members/{uid} {
      function fbPublisherKeys() {
        return ['facebookPublisher', 'facebookPublisherGrantedBy', 'facebookPublisherGrantedAt'];
      }

      function accessKeys() {
        return ['permissions', 'preset', 'accessUpdatedBy', 'accessUpdatedAt'];
      }

      function noFbPublisherFields() {
        return !request.resource.data.keys().hasAny(fbPublisherKeys());
      }

      function noAccessFields() {
        return !request.resource.data.keys().hasAny(accessKeys());
      }

      // getAfter so the bootstrap transaction (org doc + owner's member doc
      // written together) sees the new org's ownerId.
      function isOwnerAfter() {
        return signedIn() &&
          getAfter(orgPath(orgId)).data.get('ownerId', '') == request.auth.uid;
      }

      // ensureOwnerMembership() can run for any org viewer and only ever
      // creates the owner's own admin doc.
      function creatingOwnersAdminDoc() {
        return signedIn() &&
          uid == getAfter(orgPath(orgId)).data.get('ownerId', '') &&
          request.resource.data.get('role', '') == 'admin';
      }

      function acceptingOwnValidInvitation() {
        let invitationId = request.resource.data.get('invitationId', '');
        let invitation = get(/databases/$(database)/documents/organizationInvitations/$(invitationId)).data;
        return request.auth.uid == uid &&
          invitationId is string && invitationId.size() > 0 &&
          exists(/databases/$(database)/documents/organizationInvitations/$(invitationId)) &&
          invitation.organizationId == orgId &&
          invitation.normalizedEmail == normalizedEmail() &&
          invitation.status == 'pending' &&
          request.resource.data.get('role', 'staff') == invitation.get('role', 'staff') &&
          request.resource.data.get('permissions', null) == invitation.get('permissions', null) &&
          request.resource.data.get('preset', null) == invitation.get('preset', null);
      }

      allow read: if signedIn();

      allow create: if noFbPublisherFields() && (
        ((isOrgAdmin(orgId) || isOwnerAfter() || creatingOwnersAdminDoc()) && noAccessFields()) ||
        acceptingOwnValidInvitation());

      allow update: if isOrgAdmin(orgId) &&
        !changedAny(fbPublisherKeys()) &&
        !changedAny(accessKeys()) &&
        request.resource.data.get('role', 'staff') in ['admin', 'staff', 'carer'] &&
        !changedAny(['uid', 'organizationId']) &&
        (uid != orgOwnerId(orgId) || isOrgOwner(orgId) || !changedAny(['role', 'status']));

      // The last-admin check needs a query, so it stays client-side
      // (OrganizationInvitationRepository.isFinalAdmin).
      allow delete: if isOrgAdmin(orgId) && uid != orgOwnerId(orgId);
    }

    // Safe Facebook connection metadata only (the Page token lives in Secret
    // Manager). Every write goes through the facebook* callables.
    match /organizations/{orgId}/integrations/{docId} {
      allow read: if isActiveMember(orgId) || isOrgOwner(orgId);
      allow write: if false;
    }

    // Donation gap 5: the organization's stock. Received in-kind goods are
    // added by the backend (manageInKindDonation); its staff and carers
    // record usage, purchases and low-stock levels. Every change is a
    // movement row that names who made it and is never edited.
    match /organizations/{orgId}/stock/{itemId} {
      allow read: if isPlatformStaff() || staffWith(orgId, ['care', 'animals']);
      allow create, update: if staffWith(orgId, ['care', 'animals']) &&
        request.resource.data.get('quantity', 0) is number &&
        request.resource.data.get('quantity', 0) >= 0;
      allow delete: if false;
    }
    match /organizations/{orgId}/stockMovements/{moveId} {
      allow read: if isPlatformStaff() || staffWith(orgId, ['care', 'animals']);
      allow create: if staffWith(orgId, ['care', 'animals']) &&
        request.resource.data.get('byUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    // Every other organization subcollection (communityReports,
    // activityLogs, ...) keeps its current open access.
    match /organizations/{orgId}/{sub}/{document=**} {
      allow read, write: if signedIn() && !(sub in ['members', 'integrations', 'settings', 'stock', 'stockMovements',
        'careRounds', 'alertClaims', 'analyticsSummaries']);
    }

    // ---- Organization invitations ------------------------------------------

    match /organizationInvitations/{invitationId} {
      // Only the owner or an Admin invites: Staff could otherwise invite an
      // account of their own as an Admin.
      function managesOrg(orgId) {
        return isOrgAdmin(orgId);
      }

      // An invitation names a role and, for Staff, the permissions to copy
      // onto the member on acceptance ('carer' only from older app builds).
      function invitationAccessOk(data) {
        return data.get('role', 'staff') in ['admin', 'staff', 'carer'] &&
          (!('permissions' in data) || (data.permissions is list && data.permissions.hasOnly(allPermKeys())));
      }

      // The invited person may read and act on invitations addressed to
      // their own email.
      allow read: if signedIn() &&
        (resource.data.normalizedEmail == normalizedEmail() || managesOrg(resource.data.organizationId));

      allow create: if managesOrg(request.resource.data.organizationId) && invitationAccessOk(request.resource.data);

      // The invited person may only flip their own pending invitation to
      // accepted/rejected without touching org, email, or role.
      allow update: if (managesOrg(resource.data.organizationId) && invitationAccessOk(request.resource.data)) ||
        (
          resource.data.normalizedEmail == normalizedEmail() &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'rejected'] &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('permissions', null) == resource.data.get('permissions', null) &&
          request.resource.data.get('preset', null) == resource.data.get('preset', null)
        );

      allow delete: if false;
    }

    // ---- Volunteer events --------------------------------------------------
    //
    // Any signed-in user can browse events. The owning organization's staff
    // (any active member, like invitations) create, edit, and cancel them;
    // events are never deleted. goingCount only moves through a volunteer's
    // own sign-up, which must add their registration and bump the count by
    // exactly 1 in the same write (VolunteerEventRepository.register).

    match /events/{eventId} {
      function managesEventOrg(orgId) {
        return staffWith(orgId, ['volunteers']);
      }

      function registrationPath(uid) {
        return /databases/$(database)/documents/events/$(eventId)/registrations/$(uid);
      }

      function capacityOk(data) {
        return data.get('capacity', null) == null ||
          (data.capacity is int && data.capacity >= data.get('goingCount', 0));
      }

      function signingUp() {
        return signedIn() &&
          changedOnly(['goingCount']) &&
          resource.data.get('status', '') == 'published' &&
          request.resource.data.goingCount == resource.data.get('goingCount', 0) + 1 &&
          capacityOk(request.resource.data) &&
          !exists(registrationPath(request.auth.uid)) &&
          existsAfter(registrationPath(request.auth.uid));
      }

      allow read: if signedIn();

      allow create: if managesEventOrg(request.resource.data.get('organizationId', '')) &&
        request.resource.data.status == 'published' &&
        request.resource.data.goingCount == 0 &&
        capacityOk(request.resource.data);

      allow update: if signingUp() || (
        managesEventOrg(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.get('goingCount', 0) == resource.data.get('goingCount', 0) &&
        request.resource.data.status in ['published', 'cancelled'] &&
        // A cancelled event stays cancelled.
        !(resource.data.status == 'cancelled' && request.resource.data.status != 'cancelled') &&
        capacityOk(request.resource.data)
      );

      allow delete: if false;

      // Sign-ups: the volunteer and the organization's staff can read them.
      match /registrations/{uid} {
        function eventBefore() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }

        allow read: if isSelf(uid) || managesEventOrg(eventBefore().organizationId);

        // Attendance is staff-only, so a new sign-up can't arrive already
        // marked (volunteer badges count it).
        allow create: if isSelf(uid) &&
          request.resource.data.uid == uid &&
          !request.resource.data.keys().hasAny(['attended', 'attendanceMarkedAt', 'attendanceMarkedBy']) &&
          eventBefore().get('status', '') == 'published' &&
          getAfter(/databases/$(database)/documents/events/$(eventId)).data.goingCount ==
            eventBefore().get('goingCount', 0) + 1;

        // Attendance, marked by the organization's staff once the event has
        // started (VolunteerEventRepository.setAttendance).
        allow update: if managesEventOrg(eventBefore().organizationId) &&
          changedOnly(['attended', 'attendanceMarkedAt', 'attendanceMarkedBy']) &&
          request.resource.data.attended is bool &&
          request.resource.data.attendanceMarkedBy == request.auth.uid &&
          eventBefore().startAt <= request.time;

        allow delete: if false;
      }
    }

    // ---- Facebook backend bookkeeping --------------------------------------

    match /facebookConnectRequests/{requestId} {
      allow read, write: if false;
    }

    match /facebookShares/{shareId} {
      allow read, write: if false;
    }

    // ---- Campaigns ---------------------------------------------------------

    match /campaigns/{campaignId} {
      // The general view queries by type only, so reads cannot be narrowed by
      // status here (rules are not filters). Drafts are hidden in the app.
      allow read: if signedIn();
      // donation_review_inkind.dart increments numdonors by exactly 1.
      allow update: if signedIn()
        && changedOnly(['numdonors'])
        && request.resource.data.numdonors == resource.data.get('numdonors', 0) + 1;
      allow create, delete: if false;

      // Public Fund Tracking and progress updates.
      match /allocations/{allocationId} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /updates/{updateId} {
        allow read: if signedIn();
        allow write: if false;
      }
      // Audit trail: the campaign organization's finance viewers.
      match /history/{entryId} {
        allow read: if canViewFinanceOrUnowned(
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.get('organizationId', ''));
        allow write: if false;
      }
    }

    // ---- Donations ---------------------------------------------------------

    // history_provider.cancelInKindDonation
    function inKindCancel() {
      return resource.data.type == 'inkind'
        && changedOnly(['status'])
        && request.resource.data.status == 'cancelled';
    }
    // history_provider.cancelSponsorship / unCancelSponsorship / updateSponsorshipAmount
    function sponsorshipEdit() {
      return resource.data.type == 'sponsorship'
        && changedOnly(['sponsorshipStatus', 'nextChargeAmount'])
        && request.resource.data.sponsorshipStatus in ['active', 'cancelled']
        && (request.resource.data.sponsorshipStatus == 'cancelled'
            || resource.data.nextChargeDate > request.time)
        && request.resource.data.nextChargeAmount is number
        && request.resource.data.nextChargeAmount > 0;
    }
    // Donor self-service on a top-level donation doc: cancel own in-kind
    // pledge, cancel/resume own sponsorship, change next amount.
    function donorSelfServiceEdit() {
      return changedOnly(['status', 'sponsorshipStatus', 'nextChargeAmount'])
        && (!changedAny(['status'])
            || request.resource.data.status == 'cancelled')
        && (!changedAny(['sponsorshipStatus'])
            || request.resource.data.sponsorshipStatus == 'cancelled'
            || (request.resource.data.sponsorshipStatus == 'active' && resource.data.get('sponsorshipStatus', '') == 'cancelled'))
        && (!changedAny(['nextChargeAmount'])
            || (request.resource.data.nextChargeAmount is number && request.resource.data.nextChargeAmount > 0));
    }

    // Refund request flow: the donor asks once, for a paid donation or
    // sponsorship, within the time allowed (7 days; 60 for an unauthorized
    // payment), after accepting the refund terms. Only the backend
    // (recordDonationReversal) approves, declines or refunds. Keep the
    // reasons and days equal to functions/refund_rules.js.
    function donorRefundRequest() {
      let rr = request.resource.data.refundRequest;
      let days = rr.get('reason', '') == 'unauthorized' ? 60 : 7;
      return changedOnly(['refundRequest'])
        && !('refundRequest' in resource.data)
        && resource.data.get('type', '') in ['donation', 'sponsorship']
        && resource.data.get('status', '') != 'reversed'
        && resource.data.get('amount', 0) is number && resource.data.get('amount', 0) > 0
        && rr.keys().hasOnly(['status', 'reason', 'details', 'requestedAt', 'termsVersion', 'termsAcceptedAt'])
        && rr.get('status', '') == 'requested'
        && rr.get('reason', '') in ['duplicate', 'wrong_amount', 'unauthorized', 'campaign_closed', 'animal_outcome']
        && rr.get('details', '') is string && rr.get('details', '').size() <= 1000
        && rr.get('termsVersion', '') is string && rr.get('termsVersion', '').size() > 0
        && rr.get('requestedAt', null) == request.time
        && rr.get('termsAcceptedAt', null) == request.time
        && request.time < resource.data.get('timestamp', request.time) + duration.value(days, 'd');
    }

    match /donations/{donationId} {
      // Donor records (names, notes, addresses, receipts): the donor, and
      // staff (not carers) of the organization that runs the campaign —
      // organizationId is copied from the campaign by
      // stampDonationOrganization (functions/audit_logs.js). Public donor
      // counts come from campaigns/{id}.numdonors. Direct field access so
      // the donor's own queries (where userId == uid) and staff queries
      // (where organizationId == theirs) can be proven.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        canViewFinance(resource.data.organizationId)
      );
      // Every record, in-kind pledges included (pledgeInKindDonation,
      // Donation gap 9), is created by the backend.
      allow create: if false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && (donorSelfServiceEdit() || inKindCancel() || sponsorshipEdit() || donorRefundRequest());
      allow delete: if false;
    }

    // PayMongo attempts. Readable by the donor and by the people who manage
    // the money of the organization that owns the campaign (stamped by
    // createDonationCheckout; older docs: scripts/backfill_log_organization_ids.js).
    // Staff lists query by organizationId.
    match /donationPayments/{paymentId} {
      allow read: if signedIn() && (
        resource.data.get('donorId', '') == request.auth.uid ||
        canManageFinance(resource.data.get('organizationId', ''))
      );
      allow write: if false;
    }

    // Reallocation audit records: the organization's finance viewers.
    match /fundTransfers/{transferId} {
      allow read: if canViewFinanceOrUnowned(resource.data.get('organizationId', ''));
      allow write: if false;
    }

    // Backend-only bookkeeping.
    match /manualDonationRefs/{key} {
      allow read, write: if false;
    }
    match /paymongoWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ---- Users -------------------------------------------------------------

    // Profiles stay readable to signed-in users (directories, reporter and
    // transporter names). Writes are the owner's, except that an
    // organization admin may link or unlink a member's organizationId.
    //
    // Fields a user can't set on themselves:
    //   - role: only the onboarding choices (selfRoles). 'admin'/'ngo_staff'
    //     are assigned in the console.
    //   - organizationId: only an organization they own or hold an active
    //     membership in (checked after the write, so the org-bootstrap and
    //     invitation-accept transactions pass).
    //   - isVerified / transporterVerificationStatus: a user may only submit
    //     (false / 'pending'); organization staff approve or reject through
    //     staffTransporterReview below (or the console).
    match /users/{uid} {
      function selfRoles() {
        return ['', 'general', 'pet_transporter', 'rescue_volunteer', 'organization', 'organization_member'];
      }

      function canLinkSelfTo(orgId) {
        return orgId is string && orgId != '' && (
          getAfter(orgPath(orgId)).data.get('ownerId', '') == request.auth.uid ||
          (existsAfter(memberPath(orgId, uid)) &&
            !(getAfter(memberPath(orgId, uid)).data.get('status', 'active') in ['inactive', 'removed', 'disabled']))
        );
      }

      // volunteerStats (attendance counts and badges) is written only by the
      // syncVolunteerStats function (functions/volunteer_stats.js).
      function selfFieldsOk(data) {
        return data.get('role', '') in selfRoles() &&
          !('volunteerStats' in data) &&
          !('transportStatus' in data) &&
          data.get('isVerified', false) == false &&
          data.get('transporterVerificationStatus', 'pending') == 'pending' &&
          (!('organizationId' in data) || data.organizationId == null || canLinkSelfTo(data.organizationId));
      }

      function selfUpdateOk() {
        let data = request.resource.data;
        return (!changedAny(['role']) || data.get('role', '') in selfRoles()) &&
          !changedAny(['volunteerStats', 'transportStatus']) &&
          (!changedAny(['isVerified']) || data.get('isVerified', false) == false) &&
          (!changedAny(['transporterVerificationStatus']) || data.get('transporterVerificationStatus', '') == 'pending') &&
          (!changedAny(['organizationId']) ||
            !('organizationId' in data) || data.organizationId == null ||
            canLinkSelfTo(data.organizationId));
      }

      // OrganizationInvitationRepository.removeMember (unlink) and
      // OrgMembershipService.setMember (link a member of the admin's org).
      function orgAdminLinkChange() {
        let data = request.resource.data;
        return changedOnly(['organizationId']) && (
          (!('organizationId' in data) && isOrgAdmin(resource.data.get('organizationId', ''))) ||
          (('organizationId' in data) && isOrgAdmin(data.organizationId) &&
            existsAfter(memberPath(data.organizationId, uid)))
        );
      }

      // TransporterApplicationRepository.review — organization staff with
      // the volunteers permission (and platform staff) decide a pet transporter's verification, only for
      // an account that actually applied, and only those two fields.
      function staffTransporterReview() {
        let data = request.resource.data;
        return (isPlatformStaff() || myStaffWith(['volunteers'])) &&
          resource.data.get('role', '') == 'pet_transporter' &&
          exists(/databases/$(database)/documents/transporterApplications/$(uid)) &&
          changedOnly(['isVerified', 'transporterVerificationStatus']) &&
          (
            (data.get('transporterVerificationStatus', '') == 'approved' && data.get('isVerified', false) == true) ||
            (data.get('transporterVerificationStatus', '') == 'rejected' && data.get('isVerified', false) == false)
          );
      }

      // A profile holds phone, email and last known location: readable by
      // its owner, approved organization staff and platform staff (rider
      // and volunteer directories, case reporters, team pages), and members
      // of the same organization (team pages before approval). The
      // organization comparison reads the field directly so a query that
      // doesn't filter on it is denied rather than matched against ''.
      allow read: if isSelf(uid) || isPlatformStaff() || myStaffWith(opsKeys()) || isSystemAdmin() ||
        (signedIn() && myOrgId() != '' && resource.data.organizationId == myOrgId());
      allow create: if isSelf(uid) && selfFieldsOk(request.resource.data);
      allow update: if (isSelf(uid) && selfUpdateOk()) ||
        (signedIn() && orgAdminLinkChange()) ||
        staffTransporterReview();
      allow delete: if false;

      // Subcollections belong to their user (favorites, saved clinics,
      // dismissed notifications, push tokens, geofence hits, ...), except
      // the ones with their own block below.
      match /{sub}/{doc=**} {
        allow read, write: if isSelf(uid) && !(sub in [
          'history', 'donated', 'cards', 'certificates', 'notifications',
          'volunteerRegistrations', 'collarTags'
        ]);
      }
      // In-app notices from the backend (reviewOrganization, donations):
      // the user reads them, marks them read and deletes them.
      match /notifications/{noticeId} {
        allow read, delete: if isSelf(uid);
        allow update: if isSelf(uid) && changedOnly(['isRead']);
        allow create: if false;
      }
      // The volunteer's copy of each event sign-up (History reads it). The
      // event organization's staff mark attendance on it
      // (VolunteerEventRepository.setAttendance). Badges never trust this
      // copy: syncVolunteerStats counts the staff-written registration.
      match /volunteerRegistrations/{eventId} {
        function managesThisEvent() {
          let orgId = get(/databases/$(database)/documents/events/$(eventId)).data.get('organizationId', '');
          return orgId != '' && staffWith(orgId, ['volunteers']);
        }
        function attendanceFields() {
          return ['attended', 'attendanceMarkedAt', 'attendanceMarkedBy'];
        }
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid) ||
          (managesThisEvent() && request.resource.data.keys().hasOnly(attendanceFields()));
        allow update: if isSelf(uid) || (managesThisEvent() && changedOnly(attendanceFields()));
      }
      // The owner's copy of each collar tag; staff toggle QR codes on it
      // (admin_qr.dart).
      match /collarTags/{tagId} {
        allow read, write: if isSelf(uid) || isPlatformStaff() || myStaffWith(['rescue']);
      }
      match /history/{itemId} {
        allow read: if isSelf(uid);
        // Written by the backend (payments, offline gifts, in-kind pledges).
        allow create: if false;
        allow update: if isSelf(uid) && (inKindCancel() || sponsorshipEdit());
        allow delete: if false;
      }
      match /donated/{campaignId} {
        allow read, write: if isSelf(uid);
      }
      match /cards/{cardId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if false;
      }
      // Certificates of Donation: issued only by the backend (paymongo.js /
      // campaigns.js); each donor reads their own.
      match /certificates/{certificateId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ---- Rescue cases ------------------------------------------------------
    //
    // Read by anyone signed in (public map, transporter job board). Writers:
    //   - staff of the owning organization (or any approved organization's
    //     staff while the case is unowned; the staff of the organization a
    //     case is referred to), who may only stamp
    //     their own organizationId;
    //   - the reporter, for their own report (never ownership/assignment
    //     fields);
    //   - pet transporters / rescue volunteers: the one assigned or offered
    //     the case, an open-pool claim of a pending case, or a decline;
    //   - the rider sent to verify a report, for the result of that visit;
    //   - any user registering interest to adopt/foster, the interested
    //     adopter reporting arrival, and community adoption claims.

    function casePath(caseId) {
      return /databases/$(database)/documents/cases/$(caseId);
    }

    // A case referred to another organization (CaseReferralRepository)
    // records the target in referredToOrgId; that organization's staff work
    // it (accept or decline) until it is answered.
    function isReferralTarget(data) {
      return data.get('status', '') == 'referred' &&
        data.get('referredToOrgId', '') != '' &&
        data.get('referredToOrgId', '') == myOrgId() &&
        (isPlatformStaff() || myStaffWith(['rescue']));
    }

    function canStaffCase(data) {
      return canRecordOf(data.get('organizationId', ''), ['rescue']) ||
        isReferralTarget(data);
    }

    function isTransporterRole() {
      return signedIn() && myRole() in ['pet_transporter', 'rescue_volunteer'];
    }

    // A pet transporter staff verified (TransporterApplicationRepository.
    // review sets isVerified), or a rescue volunteer whose application was
    // approved. They see full reports on the job board.
    function isVerifiedResponder() {
      return isTransporterRole() && (
        (myRole() == 'pet_transporter' && userDoc().get('isVerified', false) == true) ||
        (myRole() == 'rescue_volunteer' &&
          get(/databases/$(database)/documents/volunteerApplications/$(request.auth.uid)).data
            .get('status', '') == 'approved')
      );
    }

    // Rejected as a healthy, low-urgency animal (not a lost pet): open to
    // Community Adoption, so the public may read it and claim its animals
    // (community_adoption_eligibility.dart).
    function isCommunityAdoptable(data) {
      return data.get('status', '') == 'rejected' &&
        data.get('rejectionReason', '') == 'healthyAnimalLowUrgency' &&
        data.get('rescueType', '').lower() != 'lost pet';
    }

    // Holds the case through an accepted assignment or a legacy direct claim.
    function isAssignedTransporter(data) {
      return data.get('riderId', '') == request.auth.uid ||
        data.get('assignedVolunteerId', '') == request.auth.uid;
    }

    // Holds the case's current (pending) offer.
    function isOfferedTransporter(caseId, data) {
      return data.get('currentAssignmentId', '') is string &&
        data.get('currentAssignmentId', '') != '' &&
        get(/databases/$(database)/documents/cases/$(caseId)/transportAssignments/$(data.currentAssignmentId))
          .data.get('riderId', '') == request.auth.uid;
    }

    function isCaseParticipant(caseId) {
      let data = get(casePath(caseId)).data;
      return canStaffCase(data) ||
        data.get('reporterId', '') == request.auth.uid ||
        data.get('willingAdopterId', '') == request.auth.uid ||
        (isTransporterRole() && (isAssignedTransporter(data) || isOfferedTransporter(caseId, data)));
    }

    // Mirrors loadActor({finance: true}) plus assertSameOrg in
    // functions/campaigns.js: people who manage the money of the
    // organization that owns the case.
    function canFinanceCase(data) {
      return canManageFinance(data.get('organizationId', ''));
    }

    // Donation gap 6: an expense above the organization's approval
    // threshold is saved 'pending', with no new funding, and a different
    // financial admin approves it (expense_oversight_page.dart). Nobody
    // creates an expense already approved, a pending expense gets no funding
    // lines until it is approved, it can't be quietly un-flagged, and the
    // one who asked never approves their own.
    function expenseApprovalCreateOk() {
      let status = request.resource.data.get('approvalStatus', null);
      return status == null ||
        (status == 'pending' && request.resource.data.get('fundings', []).size() == 0);
    }

    function expenseApprovalUpdateOk() {
      let before = resource.data.get('approvalStatus', null);
      let after = request.resource.data.get('approvalStatus', null);
      return (before != 'pending' || after in ['pending', 'approved']) &&
        (after != 'pending' || !changedAny(['fundings'])) &&
        (!changedAny(['approvalStatus', 'approvedBy']) || after != 'approved' || (
          before == 'pending' &&
          resource.data.get('approvalRequestedBy', '') != request.auth.uid &&
          request.resource.data.get('approvedBy', '') == request.auth.uid &&
          !changedAny(['fundings', 'amount'])
        ));
    }

    function canWorkCase(caseId) {
      let data = get(casePath(caseId)).data;
      return canStaffCase(data) ||
        (isTransporterRole() && (isAssignedTransporter(data) || isOfferedTransporter(caseId, data)));
    }

    match /cases/{caseId} {
      // riderId / assignedVolunteerId may only stay, become the caller, or
      // be cleared (a decline un-assigns).
      function riderFieldsSelfOnly() {
        let data = request.resource.data;
        return (!changedAny(['riderId']) || data.get('riderId', null) == request.auth.uid || data.get('riderId', null) == null) &&
          (!changedAny(['assignedVolunteerId']) ||
            data.get('assignedVolunteerId', null) == request.auth.uid || data.get('assignedVolunteerId', null) == null);
      }

      function transporterUpdate() {
        return isTransporterRole() &&
          !changedAny(['reporterId', 'organizationId']) &&
          riderFieldsSelfOnly() &&
          (
            isAssignedTransporter(resource.data) ||
            isOfferedTransporter(caseId, resource.data) ||
            // rescue_request.dart open-pool claim.
            (resource.data.get('status', '') == 'pending' &&
              resource.data.get('assignedVolunteerId', null) in [null, ''] &&
              request.resource.data.get('assignedVolunteerId', '') == request.auth.uid &&
              changedOnly(['status', 'assignedVolunteerId', 'assignedVolunteerName', 'statusHistory'])) ||
            // rescue_request.dart decline.
            changedOnly(['declinedBy', 'declineReasons', 'statusHistory'])
          );
      }

      // The reporter answers a live-proof request (liveProof) but never
      // writes the request, the evidence recorded with the report, or the
      // verification result.
      function reporterUpdate() {
        return resource.data.get('reporterId', '') == request.auth.uid &&
          !changedAny(['reporterId', 'organizationId', 'riderId', 'assignedVolunteerId',
            'verification', 'liveProofRequest', 'reportEvidence',
            // Rescue gaps 6/10: the adoption request mirror and the pickup
            // window belong to staff and the backend.
            'adoptionRequest', 'adopterPickup']) &&
          (!changedAny(['currentAssignmentId']) || !('currentAssignmentId' in request.resource.data));
      }

      // track_case_page.dart: register interest, then report arrival.
      function willingAdopterUpdate() {
        return (
          changedOnly(['willingAdopterId', 'willingAdopterName', 'willingAdopterType', 'statusHistory']) &&
          request.resource.data.get('willingAdopterId', '') == request.auth.uid &&
          resource.data.get('willingAdopterId', null) in [null, '']
        ) || (
          changedOnly(['adopterArrivedAtTreatment', 'statusHistory']) &&
          resource.data.get('willingAdopterId', '') == request.auth.uid
        );
      }

      // CommunityAdoptionRepository: claim animals, closing the case once
      // every animal is claimed.
      function communityClaimUpdate() {
        return isCommunityAdoptable(resource.data) &&
          changedAny(['communityAdoptionIds']) &&
          changedOnly(['communityAdoptionIds', 'claimedAnimalIndexes', 'status', 'statusHistory']) &&
          (!changedAny(['status']) || request.resource.data.status == 'closed');
      }

      // TransportAssignmentRepository.reconcileStaleOffer can run from any
      // screen showing the case; it only ever clears the offer pointer.
      function clearOfferPointer() {
        return 'currentAssignmentId' in resource.data &&
          !('currentAssignmentId' in request.resource.data) &&
          changedOnly(['currentAssignmentId']);
      }

      // CaseVerificationRepository.recordRiderOutcome: the rider staff sent
      // to check the location records what they found on that visit. Only
      // the result keys under `verification`, and the case may go from
      // verifying back to review.
      function verifierUpdate() {
        let before = resource.data.get('verification', {});
        let after = request.resource.data.get('verification', {});
        return before.get('riderId', '') == request.auth.uid &&
          changedOnly(['verification', 'statusHistory', 'status']) &&
          after.diff(before).affectedKeys().hasOnly([
            'riderOutcome', 'riderNote', 'riderMediaUrls', 'riderMediaTypes',
            'riderRecordedAt', 'riderRecordedBy', 'riderRecordedByName', 'riderLat', 'riderLng'
          ]) &&
          (!changedAny(['status']) ||
            (resource.data.get('status', '') == 'verifying' && request.resource.data.status == 'pending'));
      }

      // The full report (reporter's name and phone, verification evidence,
      // the rider's location, notes, status history): platform staff; staff
      // of the organization that owns it; any approved organization's staff
      // while it isn't owned yet (organizationId == '', the review pool);
      // the organization a case is referred to (referredToOrgId); the
      // reporter, the willing adopter, the
      // transporter holding or offered it, the rider sent to verify it,
      // verified transporters and approved volunteers (the job board), and
      // anyone for a report open to Community Adoption. Everyone else reads
      // publicCases (functions/public_cases.js). Every branch either ignores
      // the document or compares a field to the caller's uid, so queries
      // that filter on reporterId / assignedVolunteerId / riderId /
      // verification.riderId / willingAdopterId can be proven.
      // organizationId and referredToOrgId are read directly (no default)
      // so a staff query must filter on organizationId == theirs / '' or
      // referredToOrgId == theirs (RescueCaseQueryRepository.
      // watchScopedCaseDocs).
      allow read: if signedIn() && (
        // Document-only checks first, so the lookups below stay inside
        // Firestore's 1,000-expression budget.
        resource.data.get('reporterId', '') == request.auth.uid ||
        resource.data.get('willingAdopterId', '') == request.auth.uid ||
        isAssignedTransporter(resource.data) ||
        resource.data.get('verification', {}).get('riderId', '') == request.auth.uid ||
        isCommunityAdoptable(resource.data) ||
        isPlatformStaff() ||
        (resource.data.get('referredToOrgId', '') == myOrgId() && myOrgId() != '' && myStaffWith(['rescue'])) ||
        canRecordOf(resource.data.organizationId, ['rescue', 'adoptions', 'animals']) ||
        isVerifiedResponder() ||
        isOfferedTransporter(caseId, resource.data)
      );
      // Reporters file unowned reports only; an organization claims a case
      // through its staff, never by stamping it at creation.
      allow create: if signedIn() && (
        (request.resource.data.get('reporterId', '') == request.auth.uid &&
          request.resource.data.get('organizationId', '') == '') ||
        canRecordOf(request.resource.data.get('organizationId', ''), ['rescue'])
      );
      // CaseReferralRepository.withdraw: only the referring side (staff of
      // the organization that owns the case, with rescue, or the shared
      // pool for an unowned case) takes a referral back; the organization
      // it was referred to answers it with accept or decline instead.
      function referralWithdrawOk() {
        return request.resource.data.get('referralOutcome', {}).get('status', '') != 'withdrawn' ||
          !changedAny(['referralOutcome']) ||
          canRecordOf(resource.data.get('organizationId', ''), ['rescue']);
      }

      // The cheap, document-only checks run first so the ones with lookups
      // stay inside Firestore's 1,000-expression budget
      // (rules-tests/tests/expression-budget.test.js).
      allow update: if signedIn() && (
        communityClaimUpdate() ||
        clearOfferPointer() ||
        (canStaffCase(resource.data) && orgStampOk(['rescue']) && referralWithdrawOk()) ||
        reporterUpdate() ||
        transporterUpdate() ||
        willingAdopterUpdate() ||
        verifierUpdate()
      );
      allow delete: if isPlatformStaff();

      // Sightings and the activity feed: anyone signed in can add to them.
      match /communityReports/{reportId} {
        allow read, create: if signedIn();
        allow update, delete: if canStaffCase(get(casePath(caseId)).data);
      }
      // The case timeline (who did what): the people working the case.
      match /activityLogs/{logId} {
        allow read: if isCaseParticipant(caseId);
        allow create: if signedIn();
        allow update, delete: if canStaffCase(get(casePath(caseId)).data);
      }

      // Case chat and the transporter's location trail.
      match /messages/{messageId} {
        allow read, write: if isCaseParticipant(caseId);
      }
      match /tracking/{pointId} {
        allow read: if isCaseParticipant(caseId);
        allow write: if canWorkCase(caseId);
      }

      // Offers: staff create and manage them; the offered transporter
      // answers their own (TransportAssignmentRepository).
      match /transportAssignments/{assignmentId} {
        allow read: if isCaseParticipant(caseId) || resource.data.get('riderId', '') == request.auth.uid;
        allow create: if canStaffCase(get(casePath(caseId)).data);
        allow update: if canStaffCase(get(casePath(caseId)).data) || (
          resource.data.get('riderId', '') == request.auth.uid &&
          changedOnly(['status', 'respondedAt', 'acceptedAt', 'rejectedAt', 'rejectionReason', 'vehicle', 'plate', 'completedAt'])
        ) || (
          // reconcileStaleOffer from any participant's screen.
          isCaseParticipant(caseId) &&
          changedOnly(['status', 'respondedAt']) &&
          resource.data.get('status', '') == 'pending' &&
          request.resource.data.status == 'expired'
        );
        allow delete: if false;
      }

      // Case expenses are finance: the case's rescue staff and finance
      // viewers read them (treatment cost totals); only people who manage
      // the owning organization's money record, edit or delete them.
      match /expenses/{expenseId} {
        allow read: if canStaffCase(get(casePath(caseId)).data) ||
          canViewFinance(get(casePath(caseId)).data.get('organizationId', ''));
        allow create: if canFinanceCase(get(casePath(caseId)).data) && expenseApprovalCreateOk();
        allow update: if canFinanceCase(get(casePath(caseId)).data) && expenseApprovalUpdateOk();
        allow delete: if canFinanceCase(get(casePath(caseId)).data);
      }

      // Treatment logs, referrals and anything else: case staff and the
      // transporter working it.
      match /{sub}/{docId=**} {
        allow read: if !(sub in ['communityReports', 'activityLogs', 'messages', 'tracking', 'transportAssignments', 'expenses']) &&
          isCaseParticipant(caseId);
        allow write: if !(sub in ['communityReports', 'activityLogs', 'messages', 'tracking', 'transportAssignments', 'expenses']) &&
          canWorkCase(caseId);
      }
    }

    // ---- Animal records ----------------------------------------------------
    //
    // Public profiles read the animal document, so it stays readable to
    // signed-in users. Its medical subcollections (medicalSubs) are read
    // only by the owning organization's staff and its carers; the public
    // profile and adopters see only the summary fields on the animal doc.
    // Only the owning organization's staff create and edit records and
    // their subcollections (vaccinations, managementLogs, ...).

    function animalPath(animalId) {
      return /databases/$(database)/documents/animals/$(animalId);
    }

    // Animal records are edited by rescue (intake), animal records and
    // adoption (reservation, adoption) staff.
    function canStaffAnimal(data) {
      return canRecordOf(data.get('organizationId', ''), ['rescue', 'animals', 'adoptions']);
    }

    function canReadAnimalMedical(animalId) {
      let data = get(animalPath(animalId)).data;
      return canRecordOf(data.get('organizationId', ''), ['rescue', 'animals', 'adoptions']) ||
        staffWith(data.get('organizationId', ''), ['care']);
    }

    // Daily care staff of the animal's organization.
    function canCareFor(animalId) {
      return staffWith(get(animalPath(animalId)).data.get('organizationId', ''), ['care']);
    }

    // Adoption readiness gate: an animal only becomes adoptable with the
    // confirmed checklist (adoptionReadiness, written by the readiness
    // dialog). Re-saving an already adoptable animal, or releasing a
    // reservation back to adoptable, doesn't need it again.
    function readinessOnCreateOk() {
      return request.resource.data.get('adoptionStatus', '') != 'adoptable' ||
        request.resource.data.get('adoptionReadiness', null) is map;
    }

    function readinessOnUpdateOk() {
      return request.resource.data.get('adoptionStatus', '') != 'adoptable' ||
        resource.data.get('adoptionStatus', '') in ['adoptable', 'reserved'] ||
        request.resource.data.get('adoptionReadiness', null) is map;
    }

    // The full animal record: the owning organization's staff and carers,
    // platform staff, and the user it is reserved for or adopted by. Staff
    // list queries filter on organizationId (AnimalRecordRepository's
    // scoped queries) so the rule can be proven for every result. Everyone
    // else reads publicAnimals.
    //
    // organizationId is read without a default on purpose: in a list query
    // that doesn't filter on it, data.get('organizationId', '') evaluates
    // to '' ("not owned yet"), which every organization's staff may read,
    // and the query would return other organizations' animals. Read
    // directly, an unfiltered query is denied. Records missing the field
    // are readable by platform staff only (scripts/backfill_organization_ids.js).
    function canReadAnimal(data) {
      return signedIn() && (
        isPlatformStaff() ||
        data.get('reservedForUserId', '') == request.auth.uid ||
        data.get('adoptedByUserId', '') == request.auth.uid ||
        canRecordOf(data.organizationId, ['rescue', 'animals', 'adoptions']) ||
        staffWith(data.organizationId, ['care']));
    }

    match /animals/{animalId} {
      allow read: if canReadAnimal(resource.data);
      allow create: if canRecordOf(request.resource.data.get('organizationId', ''), ['rescue', 'animals', 'adoptions']) &&
        readinessOnCreateOk();
      allow update: if canStaffAnimal(resource.data) && orgStampOk(['rescue', 'animals', 'adoptions']) &&
        readinessOnUpdateOk();
      allow delete: if isPlatformStaff();

      // Dose records: daily care staff of the owning org record the doses
      // they give (givenBy must be themselves); records staff any dose.
      match /medicationDoses/{doseId} {
        allow read: if canReadAnimalMedical(animalId);
        allow create: if canStaffAnimal(get(animalPath(animalId)).data) || (
          canCareFor(animalId) &&
          request.resource.data.get('givenBy', '') == request.auth.uid
        );
        // Care staff may only rewrite their own record, never someone else's.
        allow update: if canStaffAnimal(get(animalPath(animalId)).data) || (
          canCareFor(animalId) &&
          resource.data.get('givenBy', '') == request.auth.uid &&
          request.resource.data.get('givenBy', '') == request.auth.uid
        );
        allow delete: if false;
      }

      // Care updates: care and records staff of the owning org add their own
      // (authorId must be themselves, stamped now); nobody rewrites one.
      match /careUpdates/{updateId} {
        allow read: if canReadAnimalMedical(animalId);
        allow create: if signedIn() &&
          request.resource.data.get('authorId', '') == request.auth.uid &&
          request.resource.data.get('createdAt', null) == request.time &&
          request.resource.data.get('note', '') is string &&
          request.resource.data.get('note', '').size() > 0 &&
          (canStaffAnimal(get(animalPath(animalId)).data) || canCareFor(animalId));
        allow update: if false;
        allow delete: if canStaffAnimal(get(animalPath(animalId)).data);
      }

      // Every subcollection (medical records and the managementLogs audit
      // trail) is for the owning organization's staff, its carers and
      // platform staff. The public reads publicAnimals.
      match /{sub}/{docId=**} {
        allow read: if canReadAnimalMedical(animalId);
        allow write: if sub != 'careUpdates' && canStaffAnimal(get(animalPath(animalId)).data);
      }
    }

    // Public profile of an animal, written only by the syncPublicAnimal
    // function (functions/public_animals.js): the fields meant for the
    // public and a yes/no health summary. Exists while the animal is not
    // archived, hidden or deceased.
    match /publicAnimals/{animalId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Public copy of each rescue report, written only by the syncPublicCase
    // function (functions/public_cases.js): no reporter details, rider
    // location, notes or status history; surrender reports without the
    // address and with a rounded location.
    match /publicCases/{caseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Adoption applications ---------------------------------------------
    //
    // Reads: the adopter, the owning organization's staff, and platform
    // staff. The cross-applicant "is this animal taken" check runs in the
    // hasBlockingAdoption callable (functions/adoptions.js). Staff queries
    // must filter on organizationId so the rule can be proven for every
    // result (AdoptionApplicationRepository._scoped). The adopter creates and
    // updates their own application (appointments, withdrawal, delivery
    // reschedules, return requests, follow-up check-ins); the owning
    // organization's staff manage the rest.

    function adoptionPath(adoptionId) {
      return /databases/$(database)/documents/adoptions/$(adoptionId);
    }

    function isAdopterOf(data) {
      return data.get('personal', {}).get('adopterId', '') == request.auth.uid;
    }

    function canStaffAdoption(data) {
      return canRecordOf(data.get('organizationId', ''), ['adoptions']);
    }

    match /adoptions/{adoptionId} {
      // The application belongs to the organization that owns the animal.
      function orgMatchesAnimal(data) {
        let animalId = data.get('personal', {}).get('animalRecordId', '');
        return !('organizationId' in data) || (
          animalId is string && animalId != '' &&
          get(animalPath(animalId)).data.get('organizationId', '') == data.organizationId
        );
      }

      function adopterUpdate() {
        // fitAtDecision is the score staff saved with their decision; the
        // no-show and booking-reminder counters are staff/backend only.
        return isAdopterOf(resource.data) &&
          !changedAny(['personal', 'organizationId', 'fitAtDecision',
            'noShowCount', 'noShows', 'lastNoShowAt', 'bookingReminders',
            'source', 'caseId', 'agreement']) &&
          (!changedAny(['status']) || request.resource.data.status == 'withdrawn');
      }

      // Direct field access (not .get) so queries on personal.adopterId can
      // be proven against this rule.
      // No "unowned" staff branch here: an application without an
      // organizationId is readable only by its adopter and platform staff,
      // so an unfiltered staff query can never be proven and is refused.
      allow read: if signedIn() && (
        resource.data.personal.adopterId == request.auth.uid ||
        isPlatformStaff() ||
        staffWith(resource.data.organizationId, ['adoptions'])
      );
      // Rescue gaps 6/10: an adoption request for a rescued animal, from the
      // reporter who said they want to adopt it or the user who registered
      // interest on the case. Belongs to the case's organization (none yet
      // for an unowned report; stamped when one accepts it). All three
      // agreements are required.
      function rescueRequestOk(data) {
        let c = get(casePath(data.get('caseId', 'none'))).data;
        let agreement = data.get('agreement', {});
        return data.get('source', '') == 'rescue_case' &&
          data.get('caseId', '') is string && data.get('caseId', '') != '' &&
          !('animalRecordId' in data.get('personal', {})) &&
          ((c.get('reporterId', '') == request.auth.uid && c.get('interestedToAdopt', '') == 'yes') ||
            c.get('willingAdopterId', '') == request.auth.uid) &&
          data.get('organizationId', '') == c.get('organizationId', '') &&
          agreement.get('vetFees', false) == true &&
          agreement.get('obligations', false) == true &&
          agreement.get('pickupWindow', false) == true &&
          agreement.get('care', false) == true &&
          agreement.get('noAbandon', false) == true &&
          agreement.get('infoAccurate', false) == true;
      }

      allow create: if signedIn() &&
        isAdopterOf(request.resource.data) &&
        request.resource.data.get('status', '') == 'pending' &&
        (request.resource.data.get('source', '') == 'rescue_case'
          ? rescueRequestOk(request.resource.data)
          : orgMatchesAnimal(request.resource.data));
      allow update: if signedIn() && (
        (canStaffAdoption(resource.data) && orgStampOk(['adoptions'])) ||
        adopterUpdate()
      );
      allow delete: if false;

      match /{sub}/{docId=**} {
        allow read, write: if signedIn() && (
          isAdopterOf(get(adoptionPath(adoptionId)).data) ||
          canStaffAdoption(get(adoptionPath(adoptionId)).data)
        );
      }
    }

    // ---- Volunteer applications ---------------------------------------------
    //
    // volunteerApplications/{uid}: the applicant writes their own, always as
    // pending (an edit goes back for review) and never the review fields.
    // Approved organization staff (not carers) read and review them.
    match /volunteerApplications/{uid} {
      function applicantWriteOk() {
        return isSelf(uid) &&
          request.resource.data.get('uid', '') == uid &&
          request.resource.data.get('status', '') == 'pending' &&
          !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote']);
      }

      allow read: if isSelf(uid) || isPlatformStaff() || myStaffWith(['volunteers']);
      allow create: if applicantWriteOk();
      allow update: if applicantWriteOk() || (
        (isPlatformStaff() || myStaffWith(['volunteers'])) &&
        changedOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.get('reviewedBy', '') == request.auth.uid
      );
      allow delete: if false;
    }

    // ---- Transporter applications -------------------------------------------
    //
    // transporterApplications/{uid}: identity documents (license, portrait,
    // anti-rabies record) a pet transporter submits for verification. Same
    // shape of rules as volunteerApplications: the applicant writes their own,
    // always as pending (a resubmission goes back for review) and never the
    // review fields; approved organization staff (not carers) read and review.
    // Previously unmatched here, so it fell through to the catch-all below
    // and any signed-in account could read or overwrite it.
    match /transporterApplications/{uid} {
      function applicantWriteOk() {
        return isSelf(uid) &&
          request.resource.data.get('uid', '') == uid &&
          request.resource.data.get('status', '') == 'pending' &&
          !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote']);
      }

      allow read: if isSelf(uid) || isPlatformStaff() || myStaffWith(['volunteers']);
      allow create: if applicantWriteOk();
      allow update: if applicantWriteOk() || (
        (isPlatformStaff() || myStaffWith(['volunteers'])) &&
        changedOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.get('reviewedBy', '') == request.auth.uid
      );
      allow delete: if false;
    }

    // ---- Staff dashboards (collection-group queries) -----------------------
    //
    // The dashboard, analytics and audit pages query these subcollections
    // across every parent. Collection-group queries need a {path=**} match;
    // these only add reads, writes stay with the per-parent rules above.

    match /{path=**}/transportAssignments/{assignmentId} {
      // Transporters query their own offers (where riderId == uid).
      // Staff: their own organization's offers (stamped from the case by
      // functions/audit_logs.js), through a query that filters on it. Each
      // rider's busy status for every organization is on their user doc
      // (transportStatus, functions/rider_status.js).
      allow read: if canReadOrgRecord(['rescue']) || resource.data.get('riderId', '') == request.auth.uid;
    }

    // Vaccinations, care records, medication orders and doses (animals) and
    // case expenses carry their parent's organizationId (the
    // stamp*Organization functions in functions/audit_logs.js). These
    // collection-group matches also apply to direct reads, so they must be
    // as narrow as the per-parent rules: the owning organization's staff
    // with any of `keys`, and platform staff. Dashboard queries filter on
    // organizationId so the rule can be proven.
    function canReadOrgRecord(keys) {
      let orgId = resource.data.get('organizationId', '');
      return isPlatformStaff() || (orgId != '' && staffWith(orgId, keys));
    }

    function medicalKeys() {
      return ['rescue', 'animals', 'care', 'adoptions', 'insights'];
    }

    // Dashboard: vaccine status, overdue deworming, flea & tick and vet
    // checkups, missed medication doses.
    match /{path=**}/vaccinations/{docId} {
      allow read: if canReadOrgRecord(medicalKeys());
    }

    match /{path=**}/careRecords/{docId} {
      allow read: if canReadOrgRecord(medicalKeys());
    }

    // Analytics gap 5: the Medical tab's illness log, counted on Analytics.
    match /{path=**}/illnesses/{docId} {
      allow read: if canReadOrgRecord(medicalKeys());
    }

    match /{path=**}/medications/{docId} {
      allow read: if canReadOrgRecord(medicalKeys());
    }

    match /{path=**}/medicationDoses/{docId} {
      allow read: if canReadOrgRecord(medicalKeys());
    }

    match /{path=**}/expenses/{docId} {
      allow read: if canReadOrgRecord(['rescue', 'financeView', 'financeManage']);
    }

    // Audit page, Records and Rescue tabs. stampAnimalLogOrganization /
    // stampCaseLogOrganization (functions/audit_logs.js) copy the parent's
    // organizationId onto each log; staff see only their own
    // organization's, through a query that filters on it.
    function canReadOrgLog() {
      return isPlatformStaff() ||
        (resource.data.get('organizationId', '') != '' &&
          staffWith(resource.data.get('organizationId', ''), ['insights', 'rescue', 'animals']));
    }

    match /{path=**}/managementLogs/{docId} {
      allow read: if canReadOrgLog();
    }

    match /{path=**}/activityLogs/{docId} {
      allow read: if canReadOrgLog();
    }

    // Analytics: spending by category across an organization's campaigns.
    // Allocations are public like the campaign pages that list them.
    match /{path=**}/allocations/{allocationId} {
      allow read: if signedIn();
    }

    // Staff: their own organization's follow-ups (stamped from the
    // adoption by functions/audit_logs.js). The adopter reads through the
    // per-adoption rule.
    match /{path=**}/followUps/{docId} {
      allow read: if canReadOrgRecord(['adoptions']);
    }

    // ---- General expenses ----------------------------------------------------
    //
    // orgExpenses: the organization's running costs (utilities, rent, staff
    // pay). Only the people who manage its money read or write them, and
    // only for their own organization; queries filter on organizationId.
    match /orgExpenses/{expenseId} {
      function financeOf(orgId) {
        return canManageFinance(orgId);
      }
      allow read, delete: if financeOf(resource.data.get('organizationId', ''));
      allow create: if financeOf(request.resource.data.get('organizationId', '')) &&
        expenseApprovalCreateOk() &&
        request.resource.data.get('amount', 0) is number &&
        request.resource.data.get('amount', 0) > 0;
      allow update: if financeOf(resource.data.get('organizationId', '')) &&
        !changedAny(['organizationId']) &&
        expenseApprovalUpdateOk() &&
        request.resource.data.get('amount', 0) is number &&
        request.resource.data.get('amount', 0) > 0;
    }

    // ---- Audit log ---------------------------------------------------------
    //
    // auditLogs: append-only. Anyone signed in may add an entry about their
    // own action (AuditLogRepository: logins, adoptions, staff changes,
    // expenses); the backend adds donation entries. Only the organization's
    // staff (not carers) and platform staff read them; the Audit page always
    // filters on organizationId, which is what lets this rule be proven.
    // Staff need the insights permission. Nobody edits or deletes an entry.
    match /auditLogs/{entryId} {
      allow read: if isPlatformStaff() ||
        (resource.data.get('organizationId', '') != '' &&
          staffWith(resource.data.get('organizationId', ''), ['insights']));
      allow create: if signedIn() &&
        request.resource.data.get('actorId', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('category', null) is string &&
        request.resource.data.get('action', null) is string &&
        request.resource.data.get('createdAt', null) == request.time &&
        request.resource.data.keys().hasOnly([
          'category', 'action', 'actorId', 'actorEmail', 'actorName', 'actorRole',
          'organizationId', 'targetType', 'targetId', 'oldValues', 'newValues',
          'metadata', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // ---- Community Adoption check-ins (Adoption gap 10) ---------------------
    // Written by the backend (scheduleCommunityAdoptionCheckIn). The adopter
    // answers once, with a photo and a note; staff of the organizations in
    // the area read them (queries filter on organizationIds).
    match /communityAdoptionCheckIns/{checkInId} {
      allow read: if signedIn() && (
        resource.data.get('adopterId', '') == request.auth.uid ||
        isPlatformStaff() ||
        (myOrgId() != '' && myOrgId() in resource.data.get('organizationIds', []) && myStaffWith(['adoptions']))
      );
      allow update: if signedIn() &&
        resource.data.get('adopterId', '') == request.auth.uid &&
        resource.data.get('status', '') == 'requested' &&
        changedOnly(['status', 'photoUrl', 'note', 'submittedAt']) &&
        request.resource.data.status == 'submitted';
      allow create, delete: if false;
    }

    // ---- Collar tags / rescue sessions -------------------------------------
    // Not excluded from the catch-all below (see the header note), so these
    // only add to its open access today.

    match /collarTags/{tagId} {
      allow get: if signedIn() &&
        (resource.data.qrEnabled == true || request.auth.uid == resource.data.ownerId);

      allow update: if signedIn() &&
        request.auth.uid == resource.data.ownerId &&
        changedOnly(['status', 'lastSeenLat', 'lastSeenLng', 'lastSeenAddress', 'lostAt', 'activeRescueSessionId']);
    }

    match /rescueSessions/{sessionId} {
      allow create: if false;
      allow get: if signedIn();
      allow list: if false;
      allow update: if signedIn() &&
        request.auth.uid == get(/databases/$(database)/documents/collarTags/$(resource.data.tagId)).data.ownerId &&
        changedOnly(['chatEnabledByOwner', 'status']);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          get(/databases/$(database)/documents/rescueSessions/$(sessionId)).data.chatEnabledByOwner == true &&
          get(/databases/$(database)/documents/rescueSessions/$(sessionId)).data.status != 'resolved' &&
          request.resource.data.keys().hasOnly(['sender', 'text', 'sentAt']) &&
          request.resource.data.sender in ['owner', 'finder'] &&
          (request.resource.data.sender == 'finder' ||
           request.auth.uid == get(
             /databases/$(database)/documents/collarTags/$(
               get(/databases/$(database)/documents/rescueSessions/$(sessionId)).data.tagId
             )
           ).data.ownerId);
        allow update, delete: if false;
      }
    }

    // Shareable referral links (functions/referral_shares.js). The web page
    // and the app go through callables only.
    match /referralShares/{token}/{document=**} {
      allow read, write: if false;
    }

    // ---- Everything else ---------------------------------------------------
    // Any signed-in user, except the collections with their own blocks above.

    match /{collection}/{document=**} {
      allow read, write: if signedIn() && !(collection in [
        'organizations', 'organizationInvitations', 'events',
        'facebookConnectRequests', 'facebookShares',
        'campaigns', 'donations', 'donationPayments', 'fundTransfers',
        'manualDonationRefs', 'paymongoWebhookEvents',
        'users', 'cases', 'publicCases', 'animals', 'publicAnimals', 'adoptions', 'volunteerApplications',
        'transporterApplications', 'auditLogs', 'orgExpenses', 'communityAdoptionCheckIns',
        'referralShares'
      ]);
    }
  }
}
