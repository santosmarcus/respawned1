rules_version = '2';

// Merged from the rules deployed in the Firebase console (campaigns,
// donations, users, collar tags, rescue sessions) and the repo's previous
// firestore.rules (organizations, members, invitations, Facebook). Overlapping
// matches OR together, so each path below is matched by exactly one block
// that actually grants access — the catch-alls exclude every collection that
// has its own block.
//
// Security pass (P0): users/{uid} can no longer self-assign staff roles or
// an organization; organizations can't self-approve; cases, animals and
// adoptions are writable only by the people each flow needs (owning
// organization's staff, reporter, assigned transporter, adopter).
//
// Still open to any signed-in user: reads of users, cases, animals and
// adoptions (the public map, job board and the duplicate-application check
// in adoption_application_service.dart query them unfiltered), organization
// subcollections other than members/integrations, and every collection not
// named below (collarTags, rescueSessions, petAlerts, ...). collarTags/
// rescueSessions have specific rules further down, but the app still
// creates and edits tags directly, so the catch-all keeps them open.
//
// Staff roles: users/{uid}.role 'admin'/'ngo_staff' (platform staff, set in
// the console only) or membership of an approved organization. An
// organization with no verificationStatus (bootstrapped by platform staff,
// or created before verification existed) counts as approved.
//
// Cloud Functions use the Admin SDK and bypass these rules.
// Tests: rules-tests/ (npm test, runs against the Firestore emulator).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ----------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function changedAny(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return userDoc().get('role', '');
    }

    function myOrgId() {
      return userDoc().get('organizationId', '');
    }

    // Console-assigned staff accounts main.dart routes straight into the
    // admin shell. Clients can't set these roles (see users/{uid}).
    function isPlatformStaff() {
      return signedIn() && myRole() in ['admin', 'ngo_staff'];
    }

    // Staff of an approved organization, or platform staff — the pool that
    // may pick up unowned (pending/referred) cases and read staff-only data.
    function isOrgStaff() {
      return isPlatformStaff() ||
        (signedIn() && myOrgId() != '' && isApprovedStaffOf(myOrgId()));
    }

    // ---- Organization membership helpers -----------------------------------
    //
    // Mirrors functions/facebook.js: the org's ownerId always counts, a
    // members doc counts while its status isn't inactive/removed/disabled
    // (missing status = active, for docs that predate the field).

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function orgOwnerId(orgId) {
      return get(orgPath(orgId)).data.get('ownerId', '');
    }

    function isOrgOwner(orgId) {
      return signedIn() && orgOwnerId(orgId) == request.auth.uid;
    }

    function isActiveMember(orgId) {
      return signedIn() &&
        exists(memberPath(orgId, request.auth.uid)) &&
        !(get(memberPath(orgId, request.auth.uid)).data.get('status', 'active') in ['inactive', 'removed', 'disabled']);
    }

    function isOrgAdmin(orgId) {
      return isOrgOwner(orgId) ||
        (isActiveMember(orgId) && get(memberPath(orgId, request.auth.uid)).data.get('role', '') == 'admin');
    }

    // An account acts for the organization its users/{uid}.organizationId
    // points at (as OrgMembershipService.resolveCapabilities does), unless
    // its members doc there is inactive. No members doc = an account linked
    // before members docs existed; users.organizationId is only writable
    // through a real membership now, so that link can't be forged. Checking
    // the link first keeps this cheap for everyone else — Firestore denies a
    // request once it has evaluated 1,000 expressions.
    function isStaffOf(orgId) {
      return signedIn() && orgId is string && orgId != '' && myOrgId() == orgId && (
        !exists(memberPath(orgId, request.auth.uid)) ||
        !(get(memberPath(orgId, request.auth.uid)).data.get('status', 'active') in ['inactive', 'removed', 'disabled']) ||
        isOrgOwner(orgId)
      ) && !isCarerMember(orgId);
    }

    // Carers (organization role 'carer') give care and record doses; they are
    // not staff. Every staff check above excludes them, so they cannot touch
    // cases, records, adoptions or finance.
    function isCarerMember(orgId) {
      return exists(memberPath(orgId, request.auth.uid)) &&
        get(memberPath(orgId, request.auth.uid)).data.get('role', '') == 'carer' &&
        !isOrgOwner(orgId);
    }

    function isCarerOf(orgId) {
      return signedIn() && orgId is string && orgId != '' && myOrgId() == orgId &&
        isCarerMember(orgId) && isOrgApproved(orgId) &&
        !(get(memberPath(orgId, request.auth.uid)).data.get('status', 'active') in ['inactive', 'removed', 'disabled']);
    }

    function isOrgApproved(orgId) {
      return get(orgPath(orgId)).data.get('verificationStatus', 'approved') == 'approved';
    }

    function isApprovedStaffOf(orgId) {
      return isStaffOf(orgId) && isOrgApproved(orgId);
    }

    // May act on a record owned by `orgId` ('' = not owned by anyone yet).
    function canStaffRecordOf(orgId) {
      return isPlatformStaff() ||
        (orgId != '' && isApprovedStaffOf(orgId)) ||
        (orgId == '' && isOrgStaff());
    }

    // A staff write may only (re)assign a record to an organization the
    // writer belongs to.
    function orgStampOk() {
      return !changedAny(['organizationId']) ||
        isPlatformStaff() ||
        isApprovedStaffOf(request.resource.data.get('organizationId', ''));
    }

    // Mirrors loadActor({finance: true}) in functions/campaigns.js.
    function isFinanceAdmin() {
      let u = userDoc();
      let orgId = u.get('organizationId', '');
      return signedIn() && (
        u.get('role', '') == 'admin' ||
        (orgId != '' &&
          exists(memberPath(orgId, request.auth.uid)) &&
          get(memberPath(orgId, request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // ---- Organizations -----------------------------------------------------

    // Anyone signed in can read profiles. Only the organization's own staff
    // edit them, and ownerId is fixed: it must be the creator on create and
    // can never change afterwards, since the owner gets admin rights over the
    // members subcollection.
    //
    // Verification: a new organization starts as 'draft' and its staff may
    // only submit it ('pending'). Approval/rejection happens in the console
    // (or by platform staff); an approved organization's staff get the admin
    // shell, so this must never be self-service. Only platform staff may
    // create an organization with no verificationStatus (the bootstrap path
    // in OrganizationRepository.createBootstrapOrganization).
    match /organizations/{orgId} {
      function verificationOk() {
        return !changedAny(['verificationStatus', 'bootstrapped']) || (
          !changedAny(['bootstrapped']) &&
          request.resource.data.get('verificationStatus', '') == 'pending' &&
          resource.data.get('verificationStatus', '') in ['draft', 'rejected']
        );
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        (isPlatformStaff() || (
          request.resource.data.get('verificationStatus', '') == 'draft' &&
          !('bootstrapped' in request.resource.data)
        ));
      allow update: if request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '') &&
        (isPlatformStaff() || (isStaffOf(orgId) && verificationOk()));
      allow delete: if false;
    }

    // organizations/{orgId}/members/{uid}
    //   - Only the owner or an active admin adds, edits, or removes members.
    //   - An invited person may create only their own doc, with the role
    //     their pending invitation names.
    //   - Nobody writes facebookPublisher* from the client; the
    //     facebookSetPublisher callable owns those fields.
    //   - Only the owner may change the owner's own membership, and it can
    //     never be deleted.
    // Reads stay open to signed-in users (Staff Members list, duplicate-email
    // checks).
    match /organizations/{orgId}/members/{uid} {
      function fbPublisherKeys() {
        return ['facebookPublisher', 'facebookPublisherGrantedBy', 'facebookPublisherGrantedAt'];
      }

      function noFbPublisherFields() {
        return !request.resource.data.keys().hasAny(fbPublisherKeys());
      }

      // getAfter so the bootstrap transaction (org doc + owner's member doc
      // written together) sees the new org's ownerId.
      function isOwnerAfter() {
        return signedIn() &&
          getAfter(orgPath(orgId)).data.get('ownerId', '') == request.auth.uid;
      }

      // ensureOwnerMembership() can run for any org viewer and only ever
      // creates the owner's own admin doc.
      function creatingOwnersAdminDoc() {
        return signedIn() &&
          uid == getAfter(orgPath(orgId)).data.get('ownerId', '') &&
          request.resource.data.get('role', '') == 'admin';
      }

      function acceptingOwnValidInvitation() {
        let invitationId = request.resource.data.get('invitationId', '');
        let invitation = get(/databases/$(database)/documents/organizationInvitations/$(invitationId)).data;
        return request.auth.uid == uid &&
          invitationId is string && invitationId.size() > 0 &&
          exists(/databases/$(database)/documents/organizationInvitations/$(invitationId)) &&
          invitation.organizationId == orgId &&
          invitation.normalizedEmail == normalizedEmail() &&
          invitation.status == 'pending' &&
          request.resource.data.get('role', 'staff') == invitation.get('role', 'staff');
      }

      allow read: if signedIn();

      allow create: if noFbPublisherFields() &&
        (isOrgAdmin(orgId) || isOwnerAfter() || creatingOwnersAdminDoc() || acceptingOwnValidInvitation());

      allow update: if isOrgAdmin(orgId) &&
        !changedAny(fbPublisherKeys()) &&
        !changedAny(['uid', 'organizationId']) &&
        (uid != orgOwnerId(orgId) || isOrgOwner(orgId) || !changedAny(['role', 'status']));

      // The last-admin check needs a query, so it stays client-side
      // (OrganizationInvitationRepository.isFinalAdmin).
      allow delete: if isOrgAdmin(orgId) && uid != orgOwnerId(orgId);
    }

    // Safe Facebook connection metadata only (the Page token lives in Secret
    // Manager). Every write goes through the facebook* callables.
    match /organizations/{orgId}/integrations/{docId} {
      allow read: if isActiveMember(orgId) || isOrgOwner(orgId);
      allow write: if false;
    }

    // Every other organization subcollection (communityReports,
    // activityLogs, ...) keeps its current open access.
    match /organizations/{orgId}/{sub}/{document=**} {
      allow read, write: if signedIn() && !(sub in ['members', 'integrations']);
    }

    // ---- Organization invitations ------------------------------------------

    match /organizationInvitations/{invitationId} {
      // Carers are members but not staff: they must not invite anyone, or
      // they could invite an account of their own as an admin.
      function managesOrg(orgId) {
        return (isActiveMember(orgId) && !isCarerMember(orgId)) || isOrgOwner(orgId);
      }

      // Staff Members is an equal-access module in this phase, so any active
      // member may manage invitations; the invited person may read and act
      // on invitations addressed to their own email.
      allow read: if signedIn() &&
        (resource.data.normalizedEmail == normalizedEmail() || managesOrg(resource.data.organizationId));

      allow create: if managesOrg(request.resource.data.organizationId);

      // The invited person may only flip their own pending invitation to
      // accepted/rejected without touching org, email, or role.
      allow update: if managesOrg(resource.data.organizationId) ||
        (
          resource.data.normalizedEmail == normalizedEmail() &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'rejected'] &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role
        );

      allow delete: if false;
    }

    // ---- Volunteer events --------------------------------------------------
    //
    // Any signed-in user can browse events. The owning organization's staff
    // (any active member, like invitations) create, edit, and cancel them;
    // events are never deleted. goingCount only moves through a volunteer's
    // own sign-up, which must add their registration and bump the count by
    // exactly 1 in the same write (VolunteerEventRepository.register).

    match /events/{eventId} {
      function managesEventOrg(orgId) {
        return isActiveMember(orgId) || isOrgOwner(orgId);
      }

      function registrationPath(uid) {
        return /databases/$(database)/documents/events/$(eventId)/registrations/$(uid);
      }

      function capacityOk(data) {
        return data.get('capacity', null) == null ||
          (data.capacity is int && data.capacity >= data.get('goingCount', 0));
      }

      function signingUp() {
        return signedIn() &&
          changedOnly(['goingCount']) &&
          resource.data.get('status', '') == 'published' &&
          request.resource.data.goingCount == resource.data.get('goingCount', 0) + 1 &&
          capacityOk(request.resource.data) &&
          !exists(registrationPath(request.auth.uid)) &&
          existsAfter(registrationPath(request.auth.uid));
      }

      allow read: if signedIn();

      allow create: if managesEventOrg(request.resource.data.get('organizationId', '')) &&
        request.resource.data.status == 'published' &&
        request.resource.data.goingCount == 0 &&
        capacityOk(request.resource.data);

      allow update: if signingUp() || (
        managesEventOrg(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.get('goingCount', 0) == resource.data.get('goingCount', 0) &&
        request.resource.data.status in ['published', 'cancelled'] &&
        // A cancelled event stays cancelled.
        !(resource.data.status == 'cancelled' && request.resource.data.status != 'cancelled') &&
        capacityOk(request.resource.data)
      );

      allow delete: if false;

      // Sign-ups: the volunteer and the organization's staff can read them.
      match /registrations/{uid} {
        function eventBefore() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }

        allow read: if isSelf(uid) || managesEventOrg(eventBefore().organizationId);

        allow create: if isSelf(uid) &&
          request.resource.data.uid == uid &&
          eventBefore().get('status', '') == 'published' &&
          getAfter(/databases/$(database)/documents/events/$(eventId)).data.goingCount ==
            eventBefore().get('goingCount', 0) + 1;

        allow update, delete: if false;
      }
    }

    // ---- Facebook backend bookkeeping --------------------------------------

    match /facebookConnectRequests/{requestId} {
      allow read, write: if false;
    }

    match /facebookShares/{shareId} {
      allow read, write: if false;
    }

    // ---- Campaigns ---------------------------------------------------------

    match /campaigns/{campaignId} {
      // The general view queries by type only, so reads cannot be narrowed by
      // status here (rules are not filters). Drafts are hidden in the app.
      allow read: if signedIn();
      // donation_review_inkind.dart increments numdonors by exactly 1.
      allow update: if signedIn()
        && changedOnly(['numdonors'])
        && request.resource.data.numdonors == resource.data.get('numdonors', 0) + 1;
      allow create, delete: if false;

      // Public Fund Tracking and progress updates.
      match /allocations/{allocationId} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /updates/{updateId} {
        allow read: if signedIn();
        allow write: if false;
      }
      // Audit trail: staff only.
      match /history/{entryId} {
        allow read: if isOrgStaff();
        allow write: if false;
      }
    }

    // ---- Donations ---------------------------------------------------------

    // history_provider.cancelInKindDonation
    function inKindCancel() {
      return resource.data.type == 'inkind'
        && changedOnly(['status'])
        && request.resource.data.status == 'cancelled';
    }
    // history_provider.cancelSponsorship / unCancelSponsorship / updateSponsorshipAmount
    function sponsorshipEdit() {
      return resource.data.type == 'sponsorship'
        && changedOnly(['sponsorshipStatus', 'nextChargeAmount'])
        && request.resource.data.sponsorshipStatus in ['active', 'cancelled']
        && (request.resource.data.sponsorshipStatus == 'cancelled'
            || resource.data.nextChargeDate > request.time)
        && request.resource.data.nextChargeAmount is number
        && request.resource.data.nextChargeAmount > 0;
    }
    // Donor self-service on a top-level donation doc: cancel own in-kind
    // pledge, cancel/resume own sponsorship, change next amount.
    function donorSelfServiceEdit() {
      return changedOnly(['status', 'sponsorshipStatus', 'nextChargeAmount'])
        && (!changedAny(['status'])
            || request.resource.data.status == 'cancelled')
        && (!changedAny(['sponsorshipStatus'])
            || request.resource.data.sponsorshipStatus == 'cancelled'
            || (request.resource.data.sponsorshipStatus == 'active' && resource.data.get('sponsorshipStatus', '') == 'cancelled'))
        && (!changedAny(['nextChargeAmount'])
            || (request.resource.data.nextChargeAmount is number && request.resource.data.nextChargeAmount > 0));
    }
    // donation_review_inkind.dart (no money involved)
    function inKindCreate(uid) {
      return request.resource.data.userId == uid
        && request.resource.data.type == 'inkind'
        && request.resource.data.amount == 0;
    }

    match /donations/{donationId} {
      // donation_detail.dart counts donors for any campaign.
      allow read: if signedIn();
      // Monetary records are only ever created by the backend.
      allow create: if signedIn() && inKindCreate(request.auth.uid);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && (donorSelfServiceEdit() || inKindCancel() || sponsorshipEdit());
      allow delete: if false;
    }

    // PayMongo attempts
    match /donationPayments/{paymentId} {
      allow read: if signedIn() && (resource.data.donorId == request.auth.uid || isFinanceAdmin());
      allow write: if false;
    }

    // Reallocation audit records.
    match /fundTransfers/{transferId} {
      allow read: if isOrgStaff();
      allow write: if false;
    }

    // Backend-only bookkeeping.
    match /manualDonationRefs/{key} {
      allow read, write: if false;
    }
    match /paymongoWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ---- Users -------------------------------------------------------------

    // Profiles stay readable to signed-in users (directories, reporter and
    // transporter names). Writes are the owner's, except that an
    // organization admin may link or unlink a member's organizationId.
    //
    // Fields a user can't set on themselves:
    //   - role: only the onboarding choices (selfRoles). 'admin'/'ngo_staff'
    //     are assigned in the console.
    //   - organizationId: only an organization they own or hold an active
    //     membership in (checked after the write, so the org-bootstrap and
    //     invitation-accept transactions pass).
    //   - isVerified / transporterVerificationStatus: a user may only submit
    //     (false / 'pending'); organization staff approve or reject through
    //     staffTransporterReview below (or the console).
    match /users/{uid} {
      function selfRoles() {
        return ['', 'general', 'pet_transporter', 'rescue_volunteer', 'organization', 'organization_member'];
      }

      function canLinkSelfTo(orgId) {
        return orgId is string && orgId != '' && (
          getAfter(orgPath(orgId)).data.get('ownerId', '') == request.auth.uid ||
          (existsAfter(memberPath(orgId, uid)) &&
            !(getAfter(memberPath(orgId, uid)).data.get('status', 'active') in ['inactive', 'removed', 'disabled']))
        );
      }

      function selfFieldsOk(data) {
        return data.get('role', '') in selfRoles() &&
          data.get('isVerified', false) == false &&
          data.get('transporterVerificationStatus', 'pending') == 'pending' &&
          (!('organizationId' in data) || data.organizationId == null || canLinkSelfTo(data.organizationId));
      }

      function selfUpdateOk() {
        let data = request.resource.data;
        return (!changedAny(['role']) || data.get('role', '') in selfRoles()) &&
          (!changedAny(['isVerified']) || data.get('isVerified', false) == false) &&
          (!changedAny(['transporterVerificationStatus']) || data.get('transporterVerificationStatus', '') == 'pending') &&
          (!changedAny(['organizationId']) ||
            !('organizationId' in data) || data.organizationId == null ||
            canLinkSelfTo(data.organizationId));
      }

      // OrganizationInvitationRepository.removeMember (unlink) and
      // OrgMembershipService.setMember (link a member of the admin's org).
      function orgAdminLinkChange() {
        let data = request.resource.data;
        return changedOnly(['organizationId']) && (
          (!('organizationId' in data) && isOrgAdmin(resource.data.get('organizationId', ''))) ||
          (('organizationId' in data) && isOrgAdmin(data.organizationId) &&
            existsAfter(memberPath(data.organizationId, uid)))
        );
      }

      // TransporterApplicationRepository.review — approved organization
      // staff (not carers) decide a pet transporter's verification, only for
      // an account that actually applied, and only those two fields.
      function staffTransporterReview() {
        let data = request.resource.data;
        return isOrgStaff() &&
          resource.data.get('role', '') == 'pet_transporter' &&
          exists(/databases/$(database)/documents/transporterApplications/$(uid)) &&
          changedOnly(['isVerified', 'transporterVerificationStatus']) &&
          (
            (data.get('transporterVerificationStatus', '') == 'approved' && data.get('isVerified', false) == true) ||
            (data.get('transporterVerificationStatus', '') == 'rejected' && data.get('isVerified', false) == false)
          );
      }

      allow read: if signedIn();
      allow create: if isSelf(uid) && selfFieldsOk(request.resource.data);
      allow update: if (isSelf(uid) && selfUpdateOk()) ||
        (signedIn() && orgAdminLinkChange()) ||
        staffTransporterReview();
      allow delete: if false;

      match /{sub}/{doc=**} {
        allow read, write: if signedIn() && !(sub in ['history', 'donated', 'cards', 'certificates']);
      }
      match /history/{itemId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && inKindCreate(uid);
        allow update: if isSelf(uid) && (inKindCancel() || sponsorshipEdit());
        allow delete: if false;
      }
      match /donated/{campaignId} {
        allow read, write: if isSelf(uid);
      }
      match /cards/{cardId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if false;
      }
      // Certificates of Donation: issued only by the backend (paymongo.js /
      // campaigns.js); each donor reads their own.
      match /certificates/{certificateId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ---- Rescue cases ------------------------------------------------------
    //
    // Read by anyone signed in (public map, transporter job board). Writers:
    //   - staff of the owning organization (or any approved organization's
    //     staff while the case is unowned or referred), who may only stamp
    //     their own organizationId;
    //   - the reporter, for their own report (never ownership/assignment
    //     fields);
    //   - pet transporters / rescue volunteers: the one assigned or offered
    //     the case, an open-pool claim of a pending case, or a decline;
    //   - any user registering interest to adopt/foster, the interested
    //     adopter reporting arrival, and community adoption claims.

    function casePath(caseId) {
      return /databases/$(database)/documents/cases/$(caseId);
    }

    function canStaffCase(data) {
      return canStaffRecordOf(data.get('organizationId', '')) ||
        (data.get('status', '') == 'referred' && isOrgStaff());
    }

    function isTransporterRole() {
      return signedIn() && myRole() in ['pet_transporter', 'rescue_volunteer'];
    }

    // Holds the case through an accepted assignment or a legacy direct claim.
    function isAssignedTransporter(data) {
      return data.get('riderId', '') == request.auth.uid ||
        data.get('assignedVolunteerId', '') == request.auth.uid;
    }

    // Holds the case's current (pending) offer.
    function isOfferedTransporter(caseId, data) {
      return data.get('currentAssignmentId', '') is string &&
        data.get('currentAssignmentId', '') != '' &&
        get(/databases/$(database)/documents/cases/$(caseId)/transportAssignments/$(data.currentAssignmentId))
          .data.get('riderId', '') == request.auth.uid;
    }

    function isCaseParticipant(caseId) {
      let data = get(casePath(caseId)).data;
      return canStaffCase(data) ||
        data.get('reporterId', '') == request.auth.uid ||
        data.get('willingAdopterId', '') == request.auth.uid ||
        (isTransporterRole() && (isAssignedTransporter(data) || isOfferedTransporter(caseId, data)));
    }

    function canWorkCase(caseId) {
      let data = get(casePath(caseId)).data;
      return canStaffCase(data) ||
        (isTransporterRole() && (isAssignedTransporter(data) || isOfferedTransporter(caseId, data)));
    }

    match /cases/{caseId} {
      // riderId / assignedVolunteerId may only stay, become the caller, or
      // be cleared (a decline un-assigns).
      function riderFieldsSelfOnly() {
        let data = request.resource.data;
        return (!changedAny(['riderId']) || data.get('riderId', null) == request.auth.uid || data.get('riderId', null) == null) &&
          (!changedAny(['assignedVolunteerId']) ||
            data.get('assignedVolunteerId', null) == request.auth.uid || data.get('assignedVolunteerId', null) == null);
      }

      function transporterUpdate() {
        return isTransporterRole() &&
          !changedAny(['reporterId', 'organizationId']) &&
          riderFieldsSelfOnly() &&
          (
            isAssignedTransporter(resource.data) ||
            isOfferedTransporter(caseId, resource.data) ||
            // rescue_request.dart open-pool claim.
            (resource.data.get('status', '') == 'pending' &&
              resource.data.get('assignedVolunteerId', null) in [null, ''] &&
              request.resource.data.get('assignedVolunteerId', '') == request.auth.uid &&
              changedOnly(['status', 'assignedVolunteerId', 'assignedVolunteerName', 'statusHistory'])) ||
            // rescue_request.dart decline.
            changedOnly(['declinedBy', 'declineReasons', 'statusHistory'])
          );
      }

      function reporterUpdate() {
        return resource.data.get('reporterId', '') == request.auth.uid &&
          !changedAny(['reporterId', 'organizationId', 'riderId', 'assignedVolunteerId']) &&
          (!changedAny(['currentAssignmentId']) || !('currentAssignmentId' in request.resource.data));
      }

      // track_case_page.dart: register interest, then report arrival.
      function willingAdopterUpdate() {
        return (
          changedOnly(['willingAdopterId', 'willingAdopterName', 'willingAdopterType', 'statusHistory']) &&
          request.resource.data.get('willingAdopterId', '') == request.auth.uid &&
          resource.data.get('willingAdopterId', null) in [null, '']
        ) || (
          changedOnly(['adopterArrivedAtTreatment', 'statusHistory']) &&
          resource.data.get('willingAdopterId', '') == request.auth.uid
        );
      }

      // CommunityAdoptionRepository: claim animals, closing the case once
      // every animal is claimed.
      function communityClaimUpdate() {
        return changedAny(['communityAdoptionIds']) &&
          changedOnly(['communityAdoptionIds', 'claimedAnimalIndexes', 'status', 'statusHistory']) &&
          (!changedAny(['status']) || request.resource.data.status == 'closed');
      }

      // TransportAssignmentRepository.reconcileStaleOffer can run from any
      // screen showing the case; it only ever clears the offer pointer.
      function clearOfferPointer() {
        return 'currentAssignmentId' in resource.data &&
          !('currentAssignmentId' in request.resource.data) &&
          changedOnly(['currentAssignmentId']);
      }

      allow read: if signedIn();
      // Reporters file unowned reports only; an organization claims a case
      // through its staff, never by stamping it at creation.
      allow create: if signedIn() && (
        (request.resource.data.get('reporterId', '') == request.auth.uid &&
          request.resource.data.get('organizationId', '') == '') ||
        canStaffRecordOf(request.resource.data.get('organizationId', ''))
      );
      allow update: if signedIn() && (
        (canStaffCase(resource.data) && orgStampOk()) ||
        reporterUpdate() ||
        transporterUpdate() ||
        willingAdopterUpdate() ||
        communityClaimUpdate() ||
        clearOfferPointer()
      );
      allow delete: if isPlatformStaff();

      // Sightings and the activity feed: anyone signed in can add to them.
      match /communityReports/{reportId} {
        allow read, create: if signedIn();
        allow update, delete: if canStaffCase(get(casePath(caseId)).data);
      }
      match /activityLogs/{logId} {
        allow read, create: if signedIn();
        allow update, delete: if canStaffCase(get(casePath(caseId)).data);
      }

      // Case chat and the transporter's location trail.
      match /messages/{messageId} {
        allow read, write: if isCaseParticipant(caseId);
      }
      match /tracking/{pointId} {
        allow read: if isCaseParticipant(caseId);
        allow write: if canWorkCase(caseId);
      }

      // Offers: staff create and manage them; the offered transporter
      // answers their own (TransportAssignmentRepository).
      match /transportAssignments/{assignmentId} {
        allow read: if isCaseParticipant(caseId) || resource.data.get('riderId', '') == request.auth.uid;
        allow create: if canStaffCase(get(casePath(caseId)).data);
        allow update: if canStaffCase(get(casePath(caseId)).data) || (
          resource.data.get('riderId', '') == request.auth.uid &&
          changedOnly(['status', 'respondedAt', 'acceptedAt', 'rejectedAt', 'rejectionReason', 'vehicle', 'plate', 'completedAt'])
        ) || (
          // reconcileStaleOffer from any participant's screen.
          isCaseParticipant(caseId) &&
          changedOnly(['status', 'respondedAt']) &&
          resource.data.get('status', '') == 'pending' &&
          request.resource.data.status == 'expired'
        );
        allow delete: if false;
      }

      // Treatment logs, expenses, referrals and anything else: case staff
      // and the transporter working it.
      match /{sub}/{docId=**} {
        allow read: if !(sub in ['communityReports', 'activityLogs', 'messages', 'tracking', 'transportAssignments']) &&
          isCaseParticipant(caseId);
        allow write: if !(sub in ['communityReports', 'activityLogs', 'messages', 'tracking', 'transportAssignments']) &&
          canWorkCase(caseId);
      }
    }

    // ---- Animal records ----------------------------------------------------
    //
    // Public profiles read them, so reads stay open to signed-in users.
    // Only the owning organization's staff create and edit records and
    // their subcollections (vaccinations, managementLogs, ...).

    function animalPath(animalId) {
      return /databases/$(database)/documents/animals/$(animalId);
    }

    function canStaffAnimal(data) {
      return canStaffRecordOf(data.get('organizationId', ''));
    }

    // Adoption readiness gate: an animal only becomes adoptable with the
    // confirmed checklist (adoptionReadiness, written by the readiness
    // dialog). Re-saving an already adoptable animal, or releasing a
    // reservation back to adoptable, doesn't need it again.
    function readinessOnCreateOk() {
      return request.resource.data.get('adoptionStatus', '') != 'adoptable' ||
        request.resource.data.get('adoptionReadiness', null) is map;
    }

    function readinessOnUpdateOk() {
      return request.resource.data.get('adoptionStatus', '') != 'adoptable' ||
        resource.data.get('adoptionStatus', '') in ['adoptable', 'reserved'] ||
        request.resource.data.get('adoptionReadiness', null) is map;
    }

    match /animals/{animalId} {
      allow read: if signedIn();
      allow create: if canStaffRecordOf(request.resource.data.get('organizationId', '')) && readinessOnCreateOk();
      allow update: if canStaffAnimal(resource.data) && orgStampOk() && readinessOnUpdateOk();
      allow delete: if isPlatformStaff();

      // Dose records: carers of the owning org record the doses they give
      // (givenBy must be themselves); staff can record any dose.
      match /medicationDoses/{doseId} {
        allow read: if signedIn();
        allow create: if canStaffAnimal(get(animalPath(animalId)).data) || (
          isCarerOf(get(animalPath(animalId)).data.get('organizationId', '')) &&
          request.resource.data.get('givenBy', '') == request.auth.uid
        );
        // A carer may only rewrite their own record, never another carer's.
        allow update: if canStaffAnimal(get(animalPath(animalId)).data) || (
          isCarerOf(get(animalPath(animalId)).data.get('organizationId', '')) &&
          resource.data.get('givenBy', '') == request.auth.uid &&
          request.resource.data.get('givenBy', '') == request.auth.uid
        );
        allow delete: if false;
      }

      match /{sub}/{docId=**} {
        allow read: if signedIn();
        allow write: if canStaffAnimal(get(animalPath(animalId)).data);
      }
    }

    // ---- Adoption applications ---------------------------------------------
    //
    // Reads: the adopter, the owning organization's staff, and platform
    // staff. The cross-applicant "is this animal taken" check runs in the
    // hasBlockingAdoption callable (functions/adoptions.js). Staff queries
    // must filter on organizationId so the rule can be proven for every
    // result (AdoptionApplicationRepository._scoped). The adopter creates and
    // updates their own application (appointments, withdrawal, delivery
    // reschedules, return requests, follow-up check-ins); the owning
    // organization's staff manage the rest.

    function adoptionPath(adoptionId) {
      return /databases/$(database)/documents/adoptions/$(adoptionId);
    }

    function isAdopterOf(data) {
      return data.get('personal', {}).get('adopterId', '') == request.auth.uid;
    }

    function canStaffAdoption(data) {
      return canStaffRecordOf(data.get('organizationId', ''));
    }

    match /adoptions/{adoptionId} {
      // The application belongs to the organization that owns the animal.
      function orgMatchesAnimal(data) {
        let animalId = data.get('personal', {}).get('animalRecordId', '');
        return !('organizationId' in data) || (
          animalId is string && animalId != '' &&
          get(animalPath(animalId)).data.get('organizationId', '') == data.organizationId
        );
      }

      function adopterUpdate() {
        return isAdopterOf(resource.data) &&
          !changedAny(['personal', 'organizationId']) &&
          (!changedAny(['status']) || request.resource.data.status == 'withdrawn');
      }

      // Direct field access (not .get) so queries on personal.adopterId can
      // be proven against this rule.
      // No "unowned" staff branch here: an application without an
      // organizationId is readable only by its adopter and platform staff,
      // so an unfiltered staff query can never be proven and is refused.
      allow read: if signedIn() && (
        resource.data.personal.adopterId == request.auth.uid ||
        isPlatformStaff() ||
        isApprovedStaffOf(resource.data.organizationId)
      );
      allow create: if signedIn() &&
        isAdopterOf(request.resource.data) &&
        request.resource.data.get('status', '') == 'pending' &&
        orgMatchesAnimal(request.resource.data);
      allow update: if signedIn() && (
        (canStaffAdoption(resource.data) && orgStampOk()) ||
        adopterUpdate()
      );
      allow delete: if false;

      match /{sub}/{docId=**} {
        allow read, write: if signedIn() && (
          isAdopterOf(get(adoptionPath(adoptionId)).data) ||
          canStaffAdoption(get(adoptionPath(adoptionId)).data)
        );
      }
    }

    // ---- Volunteer applications ---------------------------------------------
    //
    // volunteerApplications/{uid}: the applicant writes their own, always as
    // pending (an edit goes back for review) and never the review fields.
    // Approved organization staff (not carers) read and review them.
    match /volunteerApplications/{uid} {
      function applicantWriteOk() {
        return isSelf(uid) &&
          request.resource.data.get('uid', '') == uid &&
          request.resource.data.get('status', '') == 'pending' &&
          !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote']);
      }

      allow read: if isSelf(uid) || isOrgStaff();
      allow create: if applicantWriteOk();
      allow update: if applicantWriteOk() || (
        isOrgStaff() &&
        changedOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.get('reviewedBy', '') == request.auth.uid
      );
      allow delete: if false;
    }

    // ---- Transporter applications -------------------------------------------
    //
    // transporterApplications/{uid}: identity documents (license, portrait,
    // anti-rabies record) a pet transporter submits for verification. Same
    // shape of rules as volunteerApplications: the applicant writes their own,
    // always as pending (a resubmission goes back for review) and never the
    // review fields; approved organization staff (not carers) read and review.
    // Previously unmatched here, so it fell through to the catch-all below
    // and any signed-in account could read or overwrite it.
    match /transporterApplications/{uid} {
      function applicantWriteOk() {
        return isSelf(uid) &&
          request.resource.data.get('uid', '') == uid &&
          request.resource.data.get('status', '') == 'pending' &&
          !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote']);
      }

      allow read: if isSelf(uid) || isOrgStaff();
      allow create: if applicantWriteOk();
      allow update: if applicantWriteOk() || (
        isOrgStaff() &&
        changedOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.get('reviewedBy', '') == request.auth.uid
      );
      allow delete: if false;
    }

    // ---- Staff dashboards (collection-group queries) -----------------------
    //
    // The dashboard, analytics and audit pages query these subcollections
    // across every parent. Collection-group queries need a {path=**} match;
    // these only add reads, writes stay with the per-parent rules above.

    match /{path=**}/transportAssignments/{assignmentId} {
      // Transporters query their own offers (where riderId == uid).
      allow read: if isOrgStaff() || resource.data.get('riderId', '') == request.auth.uid;
    }

    match /{path=**}/vaccinations/{docId} {
      allow read: if isOrgStaff();
    }

    // Dashboard: overdue deworming, flea & tick and vet checkups.
    match /{path=**}/careRecords/{docId} {
      allow read: if isOrgStaff();
    }

    match /{path=**}/expenses/{docId} {
      allow read: if isOrgStaff();
    }

    match /{path=**}/managementLogs/{docId} {
      allow read: if isOrgStaff();
    }

    match /{path=**}/activityLogs/{docId} {
      allow read: if isOrgStaff();
    }

    match /{path=**}/followUps/{docId} {
      allow read: if isOrgStaff();
    }

    // ---- Collar tags / rescue sessions -------------------------------------
    // Not excluded from the catch-all below (see the header note), so these
    // only add to its open access today.

    match /collarTags/{tagId} {
      allow get: if signedIn() &&
        (resource.data.qrEnabled == true || request.auth.uid == resource.data.ownerId);

      allow update: if signedIn() &&
        request.auth.uid == resource.data.ownerId &&
        changedOnly(['status', 'lastSeenLat', 'lastSeenLng', 'lastSeenAddress', 'lostAt', 'activeRescueSessionId']);
    }

    match /rescueSessions/{sessionId} {
      allow create: if false;
      allow get: if signedIn();
      allow list: if false;
      allow update: if signedIn() &&
        request.auth.uid == get(/databases/$(database)/documents/collarTags/$(resource.data.tagId)).data.ownerId &&
        changedOnly(['chatEnabledByOwner', 'status']);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          get(/databases/$(database)/documents/rescueSessions/$(sessionId)).data.chatEnabledByOwner == true &&
          get(/databases/$(database)/documents/rescueSessions/$(sessionId)).data.status != 'resolved' &&
          request.resource.data.keys().hasOnly(['sender', 'text', 'sentAt']) &&
          request.resource.data.sender in ['owner', 'finder'] &&
          (request.resource.data.sender == 'finder' ||
           request.auth.uid == get(
             /databases/$(database)/documents/collarTags/$(
               get(/databases/$(database)/documents/rescueSessions/$(sessionId)).data.tagId
             )
           ).data.ownerId);
        allow update, delete: if false;
      }
    }

    // ---- Everything else ---------------------------------------------------
    // Any signed-in user, except the collections with their own blocks above.

    match /{collection}/{document=**} {
      allow read, write: if signedIn() && !(collection in [
        'organizations', 'organizationInvitations', 'events',
        'facebookConnectRequests', 'facebookShares',
        'campaigns', 'donations', 'donationPayments', 'fundTransfers',
        'manualDonationRefs', 'paymongoWebhookEvents',
        'users', 'cases', 'animals', 'adoptions', 'volunteerApplications',
        'transporterApplications'
      ]);
    }
  }
}
