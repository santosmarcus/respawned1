rules_version = '2';

// Cloud Storage rules. Paths mirror the app's upload call sites; anything
// not listed is denied. Staff checks read Firestore (firestore.get/exists),
// the same documents and the same organization permissions as
// firestore.rules (Admins and the owner can do everything; Staff what
// members/{uid}.permissions allow, with the same legacy fallback):
//   - platform staff = users/{uid}.role 'admin'/'ngo_staff' (no money);
//   - an account acts only for the organization users/{uid}.organizationId
//     points at.
//
// Downloads in the app go through tokenized download URLs, which bypass
// these rules; read rules here govern getDownloadURL/list from the SDK.
// Tests: rules-tests/ (npm test, runs against the Storage emulator).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function myOrg() {
      return userData().get('organizationId', '');
    }

    function isPlatform() {
      return signedIn() && userData().get('role', '') in ['admin', 'ngo_staff'];
    }

    // ---- Organization permissions (see firestore.rules) ---------------------

    function orgData(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)).data;
    }

    function hasMemberDoc(orgId) {
      return firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function memberData(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    function fullStaffPerms() {
      return ['rescue', 'animals', 'care', 'adoptions', 'campaigns', 'financeView', 'volunteers', 'insights'];
    }

    function permsOf(m) {
      return m.get('permissions',
        m.get('role', '') == 'carer' ? ['care'] :
          (m.get('facebookPublisher', false) == true ? fullStaffPerms().concat(['facebookPublish']) : fullStaffPerms()));
    }

    function memberHasAny(orgId, keys) {
      return orgData(orgId).get('verificationStatus', 'approved') == 'approved' && (
        orgData(orgId).get('ownerId', '') == request.auth.uid ||
        (!hasMemberDoc(orgId) && fullStaffPerms().hasAny(keys)) ||
        (hasMemberDoc(orgId) &&
          !(memberData(orgId).get('status', 'active') in ['inactive', 'removed', 'disabled']) &&
          (memberData(orgId).get('role', '') == 'admin' || permsOf(memberData(orgId)).hasAny(keys)))
      );
    }

    // Active member of `orgId` (their own organization) with any of `keys`.
    function staffWith(orgId, keys) {
      return signedIn() && orgId is string && orgId != '' && myOrg() == orgId && memberHasAny(orgId, keys);
    }

    function myStaffWith(keys) {
      return signedIn() && myOrg() != '' && memberHasAny(myOrg(), keys);
    }

    // A record owned by `orgId` ('' = not owned yet): platform staff, or
    // that organization's staff with any of `keys` (the caller's own for '').
    function recordStaff(orgId, keys) {
      return isPlatform() || (orgId != '' && staffWith(orgId, keys)) || (orgId == '' && myStaffWith(keys));
    }

    // The owner, or an active Admin member.
    function isOrgAdminOf(orgId) {
      return signedIn() && (
        orgData(orgId).get('ownerId', '') == request.auth.uid ||
        (hasMemberDoc(orgId) &&
          memberData(orgId).get('role', '') == 'admin' &&
          !(memberData(orgId).get('status', 'active') in ['inactive', 'removed', 'disabled']))
      );
    }

    // Uploads are capped at 100 MB (rescue videos are the largest). The app's
    // putFile calls don't set a content type, so this doesn't check one.
    // Deletes (request.resource == null) pass and fall to the ownership
    // checks alone.
    function mediaUpload() {
      return request.resource == null || request.resource.size < 100 * 1024 * 1024;
    }

    // ---- Profiles ----------------------------------------------------------

    // profile_edit_page.dart
    match /users/{uid}/{file=**} {
      allow read: if signedIn();
      allow write: if isSelf(uid) && mediaUpload();
    }

    // transporter_verification_screen.dart — ID and vehicle documents, read
    // by the staff who verify transporters.
    match /transporter_verifications/{uid}/{file=**} {
      allow read: if isSelf(uid) || isPlatform() || myStaffWith(['volunteers']);
      allow write: if isSelf(uid) && mediaUpload();
    }

    // collar_tag_form_screen.dart — pet photo shown to whoever scans a tag.
    match /collar_tags/{uid}/{file=**} {
      allow read: if signedIn();
      allow write: if isSelf(uid) && mediaUpload();
    }

    // ---- Rescue cases --------------------------------------------------------

    match /cases/{caseId} {
      function caseData() {
        return firestore.get(/databases/(default)/documents/cases/$(caseId)).data;
      }

      function caseOrg() {
        return caseData().get('organizationId', '');
      }

      function isReporter() {
        return caseData().get('reporterId', '') == request.auth.uid;
      }

      function isAssignedTransporter() {
        return caseData().get('riderId', '') == request.auth.uid ||
          caseData().get('assignedVolunteerId', '') == request.auth.uid;
      }

      // The rider staff sent to check the location before acceptance
      // (cases/{id}.verification.riderId).
      function isVerifyingRider() {
        return caseData().get('verification', {}).get('riderId', '') == request.auth.uid;
      }

      // rescue_report_service.dart (media_N), transit_case_service.dart
      // (pickup/clinic/shelter verification photos), the reporter's live
      // proof (proof_N) and the verification visit photos (verify_N).
      match /{file} {
        allow read: if signedIn();
        allow write: if signedIn() && mediaUpload() &&
          (isReporter() || isAssignedTransporter() || isVerifyingRider() || recordStaff(caseOrg(), ['rescue']));
      }

      // community_report_section.dart — anyone can attach a sighting photo.
      match /communityReports/{file} {
        allow read: if signedIn();
        allow write: if signedIn() && mediaUpload();
      }

      // treatment_detail_page.dart
      match /treatmentUpdates/{file=**} {
        allow read: if signedIn();
        allow write: if mediaUpload() && (recordStaff(caseOrg(), ['rescue', 'animals']) || isAssignedTransporter());
      }

      // add_edit_expense_sheet.dart — receipts are money: the case's rescue
      // staff and finance viewers read them, people who manage money upload.
      match /expenseReceipts/{file} {
        allow read: if staffWith(caseOrg(), ['rescue', 'financeView', 'financeManage']) ||
          (caseOrg() == '' && myStaffWith(['rescue', 'financeView', 'financeManage']));
        allow write: if mediaUpload() &&
          (staffWith(caseOrg(), ['financeManage']) || (caseOrg() == '' && myStaffWith(['financeManage'])));
      }
    }

    // Adoption gap 10: the Community Adoption check-in photo, by its adopter
    // (community_adoption_checkins.dart).
    match /communityAdoptions/{adoptionId}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && mediaUpload() &&
        firestore.get(/databases/(default)/documents/communityAdoptions/$(adoptionId)).data
          .get('adopterId', '') == request.auth.uid;
    }

    // Animal files, by folder:
    //   images/       profile photos (create_animal_record_page.dart): any
    //                 signed-in user reads; rescue, records and adoption staff
    //                 upload — the animal doc may not exist yet while a new
    //                 record is being created, so the caller's own
    //                 organization counts.
    //   medicalDocs/  care and vaccine records, medication documents
    //   careUpdates/  photos on care updates
    //   doseMedia/    dose proof
    // Everything but images/ is readable only by the owning organization's
    // staff (firestore.rules canReadAnimalMedical) and platform staff.
    // careUpdates/ and doseMedia/ also take uploads from daily care staff.
    match /animalRecords/{animalId}/{folder}/{file=**} {
      function animalOrgId() {
        return firestore.get(/databases/(default)/documents/animals/$(animalId)).data.get('organizationId', '');
      }

      allow read: if (folder == 'images' && signedIn()) ||
        (folder != 'images' && (recordStaff(animalOrgId(), ['rescue', 'animals', 'adoptions']) || staffWith(animalOrgId(), ['care'])));
      allow write: if mediaUpload() && (
        (folder == 'images' && (isPlatform() || myStaffWith(['rescue', 'animals', 'adoptions']))) ||
        (folder in ['careUpdates', 'doseMedia'] && recordStaff(animalOrgId(), ['care', 'animals'])) ||
        (!(folder in ['images', 'careUpdates', 'doseMedia']) && recordStaff(animalOrgId(), ['rescue', 'animals']))
      );
    }

    // ---- Adoptions -----------------------------------------------------------
    //
    // adoption_application_service.dart uploads the government ID, proof of
    // address and home photos BEFORE the application doc exists, so a new
    // application's folder is open to its uploader until the doc is created;
    // after that only the adopter and adoption staff can touch it.
    match /adoptions/{adoptionId}/{file=**} {
      function appData() {
        return firestore.get(/databases/(default)/documents/adoptions/$(adoptionId)).data;
      }

      function appExists() {
        return firestore.exists(/databases/(default)/documents/adoptions/$(adoptionId));
      }

      function isAdopter() {
        return appData().get('personal', {}).get('adopterId', '') == request.auth.uid;
      }

      function isAdoptionStaff() {
        return recordStaff(appData().get('organizationId', ''), ['adoptions']);
      }

      allow read: if signedIn() && (!appExists() || isAdopter() || isAdoptionStaff());
      allow write: if signedIn() && mediaUpload() && (!appExists() || isAdopter() || isAdoptionStaff());
    }

    // ---- Organizations ---------------------------------------------------------

    match /organizations/{orgId} {
      // organization_profile_edit_page.dart — the org's Admins (and platform
      // staff, who may edit org profiles).
      match /profile/{file=**} {
        allow read: if signedIn();
        allow write: if (isOrgAdminOf(orgId) || isPlatform()) && mediaUpload();
      }

      // organization_verification_screen.dart — registration papers and
      // permits. System admins read them to approve the sign-up.
      match /verification/{file=**} {
        allow read: if isOrgAdminOf(orgId) || (signedIn() && userData().get('role', '') == 'system_admin');
        allow write: if isOrgAdminOf(orgId) && mediaUpload();
      }

      // Receipts for general expenses (general_expenses_page.dart), which
      // include staff pay: only people who manage the money.
      match /expenseReceipts/{file} {
        allow read: if staffWith(orgId, ['financeManage']);
        allow write: if staffWith(orgId, ['financeManage']) && mediaUpload();
      }
    }

    // ---- Volunteer events ------------------------------------------------------

    // event_form_page.dart (VolunteerEventRepository.uploadCoverImage) —
    // event cover photos, keyed by the owning organization so a new event's
    // cover can be uploaded before its Firestore doc exists. Staff of that
    // organization who handle volunteers and events, or platform staff.
    match /events/{orgId}/{file} {
      allow read: if signedIn();
      allow write: if mediaUpload() && (isPlatform() || staffWith(orgId, ['volunteers']));
    }

    // ---- Donations ---------------------------------------------------------------

    // donation_admin_service.dart — campaign cover images (campaign staff)
    // and offline-payment receipts (money).
    match /campaigns/{file} {
      allow read: if signedIn();
      allow write: if myStaffWith(['campaigns', 'financeManage']) && mediaUpload();
    }
    match /receipts/{file} {
      allow read: if myStaffWith(['financeView', 'financeManage']);
      allow write: if myStaffWith(['financeManage']) && mediaUpload();
    }
  }
}
